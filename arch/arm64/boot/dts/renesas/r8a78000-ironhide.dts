&csi40 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			csi40_in: endpoint {
				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
				clock-lanes = <0>;
				data-lanes = <1 2 3 4>;
				pin-swap-rx-order = <ABC ACB ABC ACB>;
				remote-endpoint = <&max96726_out0>;
			};
		};
	};
};

