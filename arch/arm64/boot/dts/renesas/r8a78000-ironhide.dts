/dts-v1/;
#include "r8a78000.dtsi"
#include <dt-bindings/net/ti-dp83869.h>

/ {
	model = "Renesas Ironhide board based on r8a78000";
	compatible = "renesas,ironhide", "renesas,r8a78000";

	aliases {
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		i2c4 = &i2c4;
		i2c5 = &i2c5;
		i2c6 = &i2c6;
		i2c7 = &i2c7;
		i2c8 = &i2c8;
		serial0 = &hscif0;
	};

	chosen {
		bootargs = "ignore_loglevel rw root=/dev/nfs ip=on";
		stdout-path = "serial0:1843200n8";
	};

	memory@60600000 {
		device_type = "memory";
		/* first 518MB is reserved for other purposes. */
		reg = <0x0 0x60600000 0x0 0x5fa00000>;
	};

	memory@1080000000 {
		device_type = "memory";
		reg = <0x10 0x80000000 0x0 0x80000000>;
	};

	memory@1200000000 {
		device_type = "memory";
		reg = <0x12 0x00000000 0x1 0x00000000>;
	};

	memory@1400000000 {
		device_type = "memory";
		reg = <0x14 0x00000000 0x1 0x00000000>;
	};

	memory@1600000000 {
		device_type = "memory";
		reg = <0x16 0x00000000 0x1 0x00000000>;
	};

	memory@1800000000 {
		device_type = "memory";
		reg = <0x18 0x00000000 0x1 0x00000000>;
	};

	memory@1a00000000 {
		device_type = "memory";
		reg = <0x1a 0x00000000 0x1 0x00000000>;
	};

	memory@1c00000000 {
		device_type = "memory";
		reg = <0x1c 0x00000000 0x1 0x00000000>;
	};

	memory@1e00000000 {
		device_type = "memory";
		reg = <0x1e 0x00000000 0x1 0x00000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		linux,cma@64000000 {
			compatible = "shared-dma-pool";
			reusable;
			reg = <0x0 0x64000000 0x0 0x1c000000>;
			linux,cma-default;
		};

		frtos_app0: frtos_app0@80000000 {
			no-map;
			reg = <0x00000000 0x80000000 0x0 0x01000000>;
		};

		cr52_ram0: cr52_ram0@81000000 {
			no-map;
			reg = <0x0 0x81000000 0x0 0x50000>;
		};

		cr52_ram1: cr52_ram1@81050000 {
			no-map;
			reg = <0x0 0x81050000 0x0 0x50000>;
		};

		cr52_ram2: cr52_ram2@810a0000 {
			no-map;
			reg = <0x0 0x810a0000 0x0 0x50000>;
		};

		frtos_app1: frtos_app1@810f0000 {
			no-map;
			reg = <0x00 0x810f0000 0x00 0x3ef10000>;
		};

		rt_vram: rt_vram@1200000000 {
			no-map;
			reg = <0x12 0x00000000 0x1 0x00000000>;
		};
	};

	reg_1p8v: regulator-1p8v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-1.8V";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
	};

	reg_3p3v: regulator-3p3v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-3.3V";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};

	vspm_if {
		compatible = "renesas,vspm_if";
	};
};

&mailbox {
	status = "okay";
};

&eth_pcs {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@4 {
			reg = <4>;
			phys = <&mp_phy 2 0>;
		};

		port@5 {
			reg = <5>;
			phys = <&mp_phy 2 1>;
		};
	};
};

&mmc0 {
	pinctrl-0 = <&mmc0_pins>;
	pinctrl-1 = <&mmc0_pins>;
	pinctrl-names = "default", "state_uhs";

	vmmc-supply = <&reg_3p3v>;
	vqmmc-supply = <&reg_1p8v>;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	bus-width = <8>;
	no-sd;
	no-sdio;
	non-removable;
	full-pwr-cycle-in-suspend;
	status = "okay";
};

&extal_clk {
	clock-frequency = <16666666>;
};

&extalr_clk {
	clock-frequency = <32768>;
};

&hscif0 {
	pinctrl-0 = <&hscif0_pins>;
	pinctrl-names = "default";

	uart-has-rtscts;
	/* Please use exclusively to the scif0 node */
	status = "okay";
};

&scif_clk {
	clock-frequency = <26000000>;
};

&gpio10 {
	pcie0_clkreq {
		gpio-hog;
		gpios = <12 1>;
		output-high;
	};
};

&gpio4 {
	pcie60_clkreq {
		gpio-hog;
		gpios = <14 1>;
		output-high;
	};

	pcie61_clkreq {
		gpio-hog;
		gpios = <15 1>;
		output-high;
	};

};

&i2c0 {
	pinctrl-0 = <&i2c0_pins>;
	pinctrl-names = "default";

	status = "okay";
	clock-frequency = <100000>;

	eeprom@50 {
		compatible = "rohm,br24g01", "atmel,24c01";
		reg = <0x50>;
		pagesize = <8>;
	};
};

&mfis {
	renesas,mfis-channels = <1>;
	status = "okay";
};

&cr52_rproc1 {
	memory-region = <&cr52_ram1>;
	status = "okay";
};

&rpmsg_shm0 {
	status = "okay";
};

&rpmsg_ipi0 {
	status = "okay";
};

&cmt0 {
	status = "okay";
};

&cmt1 {
	status = "okay";
};

&cmt2 {
	status = "okay";
};

&cmt3 {
	status = "okay";
};

&tmu0 {
	status = "okay";
};

&tmu1 {
	status = "okay";
};

&tmu2 {
	status = "okay";
};

&tmu3 {
	status = "okay";
};

&tmu4 {
	status = "okay";
};

&i2c1 {
	pinctrl-0 = <&i2c1_pins>;
	pinctrl-names = "default";

	status = "okay";
	clock-frequency = <400000>;
};

&i3c0 {
	pinctrl-0 = <&i3c0_pins>;
	pinctrl-names = "default";

	status = "okay";
	sensor@72 {
		compatible = "null";
		reg = <0x72 0x0 0x10>;
	};
};

&mp_phy {
	status = "okay";
};

&pfc {
	eth25g2_pins: eth25g2 {
		groups = "eth25g2_mdio", "eth25g2_link", "eth25g2_phyint";
		function = "eth25g2";
		drive-strength = <24>;
	};

	ethes0_pins: ethes0 {
		groups = "ethes0_match", "ethes0_capture", "ethes0_pps";
		function = "ethes0";
		drive-strength = <24>;
	};

	hscif0_pins: hscif0 {
		groups = "hscif0_data", "hscif0_ctrl";
		function = "hscif0";
	};

	i2c0_pins: i2c0 {
		groups = "i2c0";
		function = "i2c0";
	};

	i2c1_pins: i2c1 {
		groups = "i2c1";
		function = "i2c1";
	};

	i3c0_pins: i3c0 {
		groups = "i3c0";
		function = "i3c0";
	};

	i3c1_pins: i3c1 {
		groups = "i3c1";
		function = "i3c1";
	};

	i3c2_pins: i3c2 {
		groups = "i3c2";
		function = "i3c2";
	};

	rsw3_pins: rsw3 {
		groups = "rsw3_match", "rsw3_capture", "rsw3_pps";
		function = "rsw3";
		drive-strength = <24>;
	};

	pcie40_pins: pcie40 {
		groups = "pcie40_clkreq_n";
		function = "pcie4";
	};

	msiof0_pins: msiof0 {
		groups = "msiof0_clk", "msiof0_sync", "msiof0_txd", "msiof0_rxd",
			"msiof0_ss1", "msiof0_ss2";
		function = "msiof0";
	};

	msiof6_pins: msiof6 {
		groups = "msiof6_clk_a", "msiof6_txd_a", "msiof6_rxd_a",
			"msiof6_ss1_a", "msiof6_ss2_a";
		function = "msiof6";
	};

	rpc_pins: rpc {
		groups = "rpc_clk2", "rpc_ctrl", "rpc_data",
			 "rpc_reset", "rpc_int";
		function = "rpc";
	};

	mmc0_pins: mmc0 {
		groups = "mmc0_data8", "mmc0_ctrl", "mmc0_ds";
		function = "mmc0";
		drive-strength = <24>;
	};

	canfd0_pins: canfd0 {
		groups = "canfd0_data";
		function = "canfd0";
	};

	canfd1_pins: canfd1 {
		groups = "canfd1_data";
		function = "canfd1";
	};

	canfd2_pins: canfd2 {
		groups = "canfd2_data";
		function = "canfd2";
	};

	canfd3_pins: canfd3 {
		groups = "canfd3_data";
		function = "canfd3";
	};

	canfd4_pins: canfd4 {
		groups = "canfd4_data";
		function = "canfd4";
	};

	canfd5_pins: canfd5 {
		groups = "canfd5_data";
		function = "canfd5";
	};

	canfd6_pins: canfd6 {
		groups = "canfd6_data";
		function = "canfd6";
	};

	canfd7_pins: canfd7 {
		groups = "canfd7_data";
		function = "canfd7";
	};

	canfd8_pins: canfd8 {
		groups = "canfd8_data";
		function = "canfd8";
	};

	canfd9_pins: canfd9 {
		groups = "canfd9_data";
		function = "canfd9";
	};

	canfd10_pins: canfd10 {
		groups = "canfd10_data";
		function = "canfd10";
	};

	canfd11_pins: canfd11 {
		groups = "canfd11_data";
		function = "canfd11";
	};

	canfd12_pins: canfd12 {
		groups = "canfd12_data_b";
		function = "canfd12";
	};

	canfd13_pins: canfd13 {
		groups = "canfd13_data_b";
		function = "canfd13";
	};

	canfd14_pins: canfd14 {
		groups = "canfd14_data_b";
		function = "canfd14";
	};

	canfd15_pins: canfd15 {
		groups = "canfd15_data_b";
		function = "canfd15";
	};

	canxl0_pins: canxl0 {
		groups = "canxl0_data";
		function = "canxl0";
	};

	canxl1_pins: canxl1 {
		groups = "canxl1_data";
		function = "canxl1";
	};
};

&rpc {
	pinctrl-0 = <&rpc_pins>;
	pinctrl-names = "default";

	status = "okay";

	flash@0 {
		compatible = "cypress,hyperflash", "cfi-flash";
		reg = <0>;
		spi-max-frequency = <160000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			boot@0 {
				reg = <0x0 0x1200000>;
				read-only;
			};

			user@2780000 {
				reg = <0x2780000 0x01880000>;
			};
		};
	};
};

&pciec40 {
	status = "okay";
	phys = <&mp_phy 0 1>;
};

&pciec60 {
	status = "okay";
};

&pciec60_ep {
	status = "disabled";
};

&pciec61 {
	status = "disabled";
};

&pciec61_ep {
	status = "disabled";
};

&rsw3_clk {
	clock-frequency = <66660000>;
};

&rswitch3 {
	status = "okay";
	pinctrl-0 = <&rsw3_pins>, <&eth25g2_pins>, <&ethes0_pins>;
	pinctrl-names = "default";

	ethernet-ports {
		#address-cells = <1>;
		#size-cells = <0>;

		// TODO: Add more ports (e.g., port@0, port@1) as needed
		port@4 {
			reg = <4>;
			renesas,etha-mii-chan = <4>;
			phy-handle = <&q32xx_phy>;
			phy-mode = "usxgmii";
			phys = <&eth_pcs 4>;
			max-speed = <10000>;

			mdio {
				#address-cells = <1>;
				#size-cells = <0>;
				q32xx_phy: ethernet-phy@1 {
					reg = <1>;
					compatible = "ethernet-phy-ieee802.3-c45";
				};
			};
		};

		port@5 {
			reg = <5>;
			renesas,etha-mii-chan = <4>;
			renesas,connect_to_xpcs;
			phy-handle = <&dp83869_phy>;
			phy-mode = "sgmii";
			phys = <&eth_pcs 5>;

			mdio {
				#address-cells = <1>;
				#size-cells = <0>;
				dp83869_phy: ethernet-phy@2 {
					reg = <2>;
					ti,sgmii-interface;
					ti,max-output-impedance;
					ti,refclk-output-enable;
					ti,clk-output-sel = <DP83869_CLK_O_SEL_REF_CLK>;
				};
			};
		};

		/* Example stub for future ports */
		//	port@5 {
		//	reg = <5>;
		//	phy-handle = <&mv_phy5>;
		//	phy-mode = "usxgmii";
		//	local-mac-address = [xx xx xx xx xx xx];
		//	phys = <&eth_pcs X>;
		//	...
		// };
	};
};

&rwdt {
	timeout-sec = <60>;
	status = "okay";
};

&crc0 {
	status = "okay";
};

&crc1 {
	status = "okay";
};

&crc2 {
	status = "okay";
};

&crc3 {
	status = "okay";
};

&crc4 {
	status = "okay";
};

&crc5 {
	status = "okay";
