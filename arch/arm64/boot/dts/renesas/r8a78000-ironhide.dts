&crc8 {
	status = "okay";
};

&crc9 {
	status = "okay";
};

&crc10 {
	status = "okay";
};

&kcrc0 {
	status = "okay";
};

&kcrc1 {
	status = "okay";
};

&kcrc2 {
	status = "okay";
};

&kcrc3 {
	status = "okay";
};

&kcrc4 {
	status = "okay";
};

&kcrc5 {
	status = "okay";
};

&kcrc6 {
	status = "okay";
};

&kcrc7 {
	status = "okay";
};

&kcrc8 {
	status = "okay";
};

&kcrc9 {
	status = "okay";
};

&kcrc10 {
	status = "okay";
};

&wcrc0 {
	status = "okay";
};

&wcrc1 {
	status = "okay";
};

&wcrc2 {
	status = "okay";
};

&wcrc3 {
	status = "okay";
};

&wcrc4 {
	status = "okay";
};

&wcrc5 {
	status = "okay";
};

&wcrc6 {
	status = "okay";
};

&wcrc7 {
	status = "okay";
};

&wcrc8 {
	status = "okay";
};

&wcrc9 {
	status = "okay";
};

&wcrc10 {
	status = "okay";
};

&ufs0 {
	status = "okay";
};

&ufs1 {
	status = "okay";
};

&ufs0_clk {
	clock-frequency = <38400000>;
};

&ufs1_clk {
	clock-frequency = <38400000>;
};

&vspi0 {
	status = "okay";
};

&vspi1 {
	status = "okay";
};

&vspi2 {
	status = "okay";
};

&vspi3 {
	status = "okay";
};

&vspb0 {
	status = "okay";
};

&vspb1 {
	status = "okay";
};

&vspb2 {
	status = "okay";
};

&vspb3 {
	status = "okay";
};

&vspb4 {
	status = "okay";
};

&canfd_0 {
	pinctrl-0 = <&canfd0_pins>, <&canfd1_pins>, <&canfd2_pins>,
		    <&canfd3_pins>, <&canfd4_pins>, <&canfd5_pins>,
		    <&canfd6_pins>, <&canfd7_pins>;
	pinctrl-names = "default";
	status = "okay";

	channel0 {
		status = "okay";
	};

	channel1 {
		status = "okay";
	};

	channel2 {
		status = "okay";
	};

	channel3 {
		status = "okay";
	};

	channel4 {
		status = "okay";
	};

	channel5 {
		status = "okay";
	};

	channel6 {
		status = "okay";
	};

	channel7 {
		status = "okay";
	};
};

&canfd_1 {
	pinctrl-0 = <&canfd8_pins>, <&canfd9_pins>, <&canfd10_pins>,
		    <&canfd11_pins>, <&canfd12_pins>, <&canfd13_pins>,
		    <&canfd14_pins>, <&canfd15_pins>;
	pinctrl-names = "default";
	status = "okay";

	channel0 {
		status = "okay";
