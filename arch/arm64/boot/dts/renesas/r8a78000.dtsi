		};

		L3_CA720_4: cache-controller-4 {
			compatible = "cache";
			cache-unified;
			cache-level = <3>;
		};

		L3_CA720_5: cache-controller-5 {
			compatible = "cache";
			cache-unified;
			cache-level = <3>;
		};

		L3_CA720_6: cache-controller-6 {
			compatible = "cache";
			cache-unified;
			cache-level = <3>;
		};

		L3_CA720_7: cache-controller-7 {
			compatible = "cache";
			cache-unified;
			cache-level = <3>;
		};
	};

	extal_clk: extal {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		/* This value must be overridden by the board */
		clock-frequency = <0>;
	};

	extalr_clk: extalr {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		/* This value must be overridden by the board */
		clock-frequency = <0>;
	};

	firmware {
		scmi {
			compatible = "arm,scmi";
			mbox-names = "tx","rx";
			mboxes = <&mailbox 0 &mailbox 1>;
			shmem = <&cpu_scp_lpri0 &cpu_scp_hpri0>;
			#address-cells = <1>;
			#size-cells = <0>;

			scmi_devpd: protocol@11 {
				reg = <0x11>;
				#power-domain-cells = <1>;
			};

			scmi_sys: protocol@12 {
				reg = <0x12>;
			};

			scmi_clk: protocol@14 {
				reg = <0x14>;
				#clock-cells = <1>;
			};

			scmi_reset: protocol@16 {
				reg = <0x16>;
				#reset-cells = <1>;
			};
		};

		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
		};
	};

	pmu_a720 {
		compatible = "arm,cortex-a720-pmu";
		interrupts-extended = <&gic GIC_PPI 7 IRQ_TYPE_LEVEL_LOW>;
	};

	psci {
		compatible = "arm,psci-1.0", "arm,psci-0.2";
		method = "smc";
	};

	/* In the early phase, there is no clock control support,
	 * so assume that the clocks are enabled by default.
	 * Therefore, dummy clocks are used.
	 */
	dummy_clk_sgasyncd4: dummy_clk_sgasyncd4 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <266660000>;
	};

	dummy_clk_wdt: dummy_clk_wdt {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32800>;
		clock-output-names = "watchdog";
	};

	rsw3_clk: rsw3_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <0>;
	};

	dummy_clk_wcrc: dummy_clk_wcrc {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <0>;
	};

	/* External SCIF clock - to be overridden by boards that provide it */
	scif_clk: scif {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <0>;
	};

	/* External PCIe clock - can be overridden by the board */
	pcie4_bus_clk: pcie4_bus {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <100000000>;
	};

	pcie6_bus_clk: pcie6_bus {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <100000000>;
	};

	rpc_ref_clk: rpc_ref_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <160000000>;
		clock-output-names = "rpc";
	};

	soc: soc {
		compatible = "simple-bus";
		interrupt-parent = <&gic>;
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		mfis: mfis@18800000 {
			compatible = "renesas,mfis";
			reg = <0x0 0x18800000 0x0 0x1000>,
			      <0x0 0x18801000 0x0 0x1000>,
			      <0x0 0x18802000 0x0 0x1000>,
			      <0x0 0x18803000 0x0 0x1000>,
			      <0x0 0x18804000 0x0 0x1000>,
			      <0x0 0x18805000 0x0 0x1000>,
			      <0x0 0x18806000 0x0 0x1000>,
			      <0x0 0x18807000 0x0 0x1000>,
			      <0x0 0x189e0900 0x0 0x4>;
			reg-names = "ch0", "ch1", "ch2", "ch3",
				    "ch4", "ch5", "ch6", "ch7",
				     "unlock_reg";
			interrupts = <GIC_SPI 101 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 103 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 105 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 107 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 109 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 111 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 113 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 115 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "ch0", "ch1", "ch2", "ch3",
					  "ch4", "ch5", "ch6", "ch7";
			renesas,mfis-channels = <0 1 2>;
			status = "disabled";
		};

		mailbox: mfis_mbox@18842000 {
			compatible = "renesas,mfis-mbox";
			#mbox-cells = <1>;
			reg = <0x0 0x18842004 0x0 0x4>,
			      <0x0 0x18842000 0x0 0x4>;
			interrupts = <GIC_SPI 4362 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
		};

		mfis_lock@189e0000 {
			compatible = "renesas,mfis-lock-r8a78000",
				     "renesas,mfis-lock-gen5";
			reg = <0 0x189e0000 0 0x900>, <0x0 0x189e0900 0x0 0x4>;
			reg-names = "io_base", "unlock_reg";
			#hwlock-cells = <1>;
		};

		prr: chipid@189e0044 {
			compatible = "renesas,prr";
			reg = <0 0x189e0044 0 4>;
		};

		/* The Arm GIC-700AE - View 1 */
		gic: interrupt-controller@39000000 {
			compatible = "arm,gic-v3";
			#interrupt-cells = <3>;
			#address-cells = <0>;
			interrupt-controller;
			redistributor-stride = <0x0 0x40000>;
#ifndef GIC_MULTI_VIEW /* Single-view */
			#redistributor-regions = <1>;
			reg = <0x0 0x39000000 0 0x20000>,
			      <0x0 0x39080000 0 0x810000>;
#else	/* Multi-view */
			#redistributor-regions = <32>;
			reg = <0x0 0x39000000 0x0 0x20000>, // GICD
			      <0x0 0x39080000 0x0 0x40000>, // GICR Core0
			      <0x0 0x390C0000 0x0 0x40000>, // GICR Core1
			      <0x0 0x39100000 0x0 0x40000>, // GICR Core2
			      <0x0 0x39140000 0x0 0x40000>, // GICR Core3
			      <0x0 0x39180000 0x0 0x40000>, // GICR Core4
			      <0x0 0x391C0000 0x0 0x40000>, // GICR Core5
			      <0x0 0x39200000 0x0 0x40000>, // GICR Core6
			      <0x0 0x39240000 0x0 0x40000>, // GICR Core7
			      <0x0 0x39280000 0x0 0x40000>, // GICR Core8
			      <0x0 0x392C0000 0x0 0x40000>, // GICR Core9
			      <0x0 0x39300000 0x0 0x40000>, // GICR Core10
			      <0x0 0x39340000 0x0 0x40000>, // GICR Core11
			      <0x0 0x39380000 0x0 0x40000>, // GICR Core12
			      <0x0 0x393C0000 0x0 0x40000>, // GICR Core13
			      <0x0 0x39400000 0x0 0x40000>, // GICR Core14
			      <0x0 0x39440000 0x0 0x40000>, // GICR Core15
			      <0x0 0x39480000 0x0 0x40000>, // GICR Core16
			      <0x0 0x394C0000 0x0 0x40000>, // GICR Core17
			      <0x0 0x39500000 0x0 0x40000>, // GICR Core18
			      <0x0 0x39540000 0x0 0x40000>, // GICR Core19
			      <0x0 0x39580000 0x0 0x40000>, // GICR Core20
			      <0x0 0x395C0000 0x0 0x40000>, // GICR Core21
			      <0x0 0x39600000 0x0 0x40000>, // GICR Core22
			      <0x0 0x39640000 0x0 0x40000>, // GICR Core23
			      <0x0 0x39680000 0x0 0x40000>, // GICR Core24
			      <0x0 0x396C0000 0x0 0x40000>, // GICR Core25
			      <0x0 0x39700000 0x0 0x40000>, // GICR Core26
			      <0x0 0x39740000 0x0 0x40000>, // GICR Core27
			      <0x0 0x39780000 0x0 0x40000>, // GICR Core28
			      <0x0 0x397C0000 0x0 0x40000>, // GICR Core29
			      <0x0 0x39800000 0x0 0x40000>, // GICR Core30
			      <0x0 0x39840000 0x0 0x40000>; // GICR Core31
#endif
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
		};

		pfc: pinctrl@c0400000 {
			compatible = "renesas,pfc-r8a78000";
			reg = <0 0xc1080000 0 0x104>, <0 0xc1080800 0 0x104>,
			      <0 0xc1081000 0 0x104>, <0 0xc0800000 0 0x104>,
			      <0 0xc0800800 0 0x104>, <0 0xc0400000 0 0x104>,
			      <0 0xc0400800 0 0x104>, <0 0xc0401000 0 0x104>,
			      <0 0xc0401800 0 0x104>, <0 0xc9b00000 0 0x104>,
			      <0 0xc9b00800 0 0x104>;
		};

		cmt0: timer@c64c0000 {
			compatible = "renesas,rcar-gen5-cmt0";
			reg = <0 0xc64c0000 0 0x1004>;
			interrupts = <GIC_SPI 4088 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4089 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&scmi_clk SCP_CLOCK_ID_MDLC_CMT0>;
			clock-names = "fck";
			status = "disabled";
		};

		cmt1: timer@c64d0000 {
			compatible = "renesas,rcar-gen5-cmt1";
			reg = <0 0xc64d0000 0 0x1004>;
			interrupts = <GIC_SPI 4090 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4091 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4092 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4093 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4094 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4095 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4096 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4097 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&scmi_clk SCP_CLOCK_ID_MDLC_CMT1>;
			clock-names = "fck";
			status = "disabled";
		};

		cmt2: timer@c64e0000 {
			compatible = "renesas,rcar-gen5-cmt1";
			reg = <0 0xc64e0000 0 0x1004>;
			interrupts = <GIC_SPI 4098 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4099 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4100 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4101 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4102 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4103 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4104 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4105 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&scmi_clk SCP_CLOCK_ID_MDLC_CMT2>;
			clock-names = "fck";
			status = "disabled";
		};

		cmt3: timer@c64e8000 {
			compatible = "renesas,rcar-gen5-cmt1";
			reg = <0 0xc64e8000 0 0x1004>;
			interrupts = <GIC_SPI 4106 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4107 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4108 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4109 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4110 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4111 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4112 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4113 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&scmi_clk SCP_CLOCK_ID_MDLC_CMT3>;
			clock-names = "fck";
			status = "disabled";
		};

		tmu0: timer@1c030000 {
			compatible = "renesas,tmu";
			reg = <0 0x1c030000 0 0x30>;
			renesas,clk-rate-channel0;
			interrupts = <GIC_SPI 4114 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4115 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4116 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&scmi_clk SCP_CLOCK_ID_MDLC_TMU0>;
			clock-names = "fck";
			status = "disabled";
		};

		tmu1: timer@c0680000 {
			compatible = "renesas,tmu";
			reg = <0 0xc0680000 0 0x30>;
			interrupts = <GIC_SPI 4117 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4118 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4119 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4120 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&scmi_clk SCP_CLOCK_ID_MDLC_TMU1>;
			clock-names = "fck";
			status = "disabled";
		};

		tmu2: timer@c0690000 {
			compatible = "renesas,tmu";
			reg = <0 0xc0690000 0 0x30>;
			interrupts = <GIC_SPI 4121 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4122 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4123 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4124 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&scmi_clk SCP_CLOCK_ID_MDLC_TMU2>;
			clock-names = "fck";
			status = "disabled";
		};

		tmu3: timer@c06a0000 {
			compatible = "renesas,tmu";
			reg = <0 0xc06a0000 0 0x30>;
			interrupts = <GIC_SPI 4125 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4126 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4127 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4128 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&scmi_clk SCP_CLOCK_ID_MDLC_TMU3>;
			clock-names = "fck";
			status = "disabled";
		};

		tmu4: timer@c06b0000 {
			compatible = "renesas,tmu";
			reg = <0 0xc06b0000 0 0x30>;
			interrupts = <GIC_SPI 4129 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4130 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4131 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 4132 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&scmi_clk SCP_CLOCK_ID_MDLC_TMU4>;
			clock-names = "fck";
			status = "disabled";
		};

		i2c0: i2c@c11d0000 {
			compatible = "renesas,i2c-r8a78000",
				     "renesas,rcar-gen5-i2c";
			reg = <0 0xc11d0000 0 0x40>;
			interrupts = <GIC_SPI 4807 IRQ_TYPE_LEVEL_HIGH>;
			i2c-scl-internal-delay-ns = <110>;
			clocks = <&scmi_clk X5H_CLOCK_ID_I2C0>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c1: i2c@c06c0000 {
			compatible = "renesas,i2c-r8a78000",
				     "renesas,rcar-gen5-i2c";
			reg = <0 0xc06c0000 0 0x40>;
			interrupts = <GIC_SPI 956 IRQ_TYPE_LEVEL_HIGH>;
			i2c-scl-internal-delay-ns = <110>;
			clocks = <&scmi_clk X5H_CLOCK_ID_I2C1>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c2: i2c@c06c8000 {
			compatible = "renesas,i2c-r8a78000",
				     "renesas,rcar-gen5-i2c";
			reg = <0 0xc06c8000 0 0x40>;
			interrupts = <GIC_SPI 957 IRQ_TYPE_LEVEL_HIGH>;
			i2c-scl-internal-delay-ns = <110>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c3: i2c@c06d0000 {
			compatible = "renesas,i2c-r8a78000",
				     "renesas,rcar-gen5-i2c";
			reg = <0 0xc06d0000 0 0x40>;
			interrupts = <GIC_SPI 958 IRQ_TYPE_LEVEL_HIGH>;
			i2c-scl-internal-delay-ns = <110>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c4: i2c@c06d8000 {
			compatible = "renesas,i2c-r8a78000",
				     "renesas,rcar-gen5-i2c";
			reg = <0 0xc06d8000 0 0x40>;
			interrupts = <GIC_SPI 959 IRQ_TYPE_LEVEL_HIGH>;
			i2c-scl-internal-delay-ns = <110>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c5: i2c@c06e0000 {
			compatible = "renesas,i2c-r8a78000",
				     "renesas,rcar-gen5-i2c";
			reg = <0 0xc06e0000 0 0x40>;
			interrupts = <GIC_SPI 4064 IRQ_TYPE_LEVEL_HIGH>;
			i2c-scl-internal-delay-ns = <110>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c6: i2c@c06e8000 {
			compatible = "renesas,i2c-r8a78000",
				     "renesas,rcar-gen5-i2c";
			reg = <0 0xc06e8000 0 0x40>;
			interrupts = <GIC_SPI 4065 IRQ_TYPE_LEVEL_HIGH>;
			i2c-scl-internal-delay-ns = <110>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c7: i2c@c06f0000 {
			compatible = "renesas,i2c-r8a78000",
				     "renesas,rcar-gen5-i2c";
			reg = <0 0xc06f0000 0 0x40>;
			interrupts = <GIC_SPI 4066 IRQ_TYPE_LEVEL_HIGH>;
			i2c-scl-internal-delay-ns = <110>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c8: i2c@c06f8000 {
			compatible = "renesas,i2c-r8a78000",
				     "renesas,rcar-gen5-i2c";
			reg = <0 0xc06f8000 0 0x40>;
			interrupts = <GIC_SPI 4067 IRQ_TYPE_LEVEL_HIGH>;
			i2c-scl-internal-delay-ns = <110>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i3c0: i3c-master@c0788000 {
			compatible = "renesas,rcar-i3c-master";
			reg = <0 0xc0788000 0 0x1000>;
			interrupts = <GIC_SPI 4068 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&scmi_clk SCP_CLOCK_ID_MDLC_I3C0>,
				 <&scmi_clk SCP_CLOCK_ID_CLK_SASYNCCK_I3C_PERW>;
			#address-cells = <3>;
			#size-cells = <0>;
			i2c-scl-hz = <400000>;
			i3c-scl-hz = <12500000>;
			status = "disabled";
		};

		i3c1: i3c-master@c0789000 {
			compatible = "renesas,rcar-i3c-master";
			reg = <0 0xc0789000 0 0x1000>;
			interrupts = <GIC_SPI 4069 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&scmi_clk SCP_CLOCK_ID_MDLC_I3C1>,
				 <&scmi_clk SCP_CLOCK_ID_CLK_SASYNCCK_I3C_PERW>;
			#address-cells = <3>;
			#size-cells = <0>;
			i2c-scl-hz = <400000>;
			i3c-scl-hz = <12500000>;
			status = "disabled";
		};

		i3c2: i3c-master@c078a000 {
			compatible = "renesas,rcar-i3c-master";
			reg = <0 0xc078a000 0 0x1000>;
			interrupts = <GIC_SPI 4070 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&scmi_clk SCP_CLOCK_ID_MDLC_I3C2>,
				 <&scmi_clk SCP_CLOCK_ID_CLK_SASYNCCK_I3C_PERW>;
			#address-cells = <3>;
			#size-cells = <0>;
			i2c-scl-hz = <400000>;
			i3c-scl-hz = <12500000>;
			status = "disabled";
		};

		rwdt: watchdog@1c040000 {
			compatible = "renesas,r8a78000-wdt",
				     "renesas,rcar-gen5-wdt";
			reg = <0 0x1c040000 0 0x0c>;
			clock = <&dummy_clk_wdt>;
			status = "disabled";
		};

		wwdt0: watchdog@1c100000 {
			compatible = "renesas, rcar-gen5-wwdt";
			reg = <0 0x1c100000 0 0x10000>;
			status = "disabled";
		};

		wwdt1: watchdog@1c110000 {
			compatible = "renesas, rcar-gen5-wwdt";
			reg = <0 0x1c110000 0 0x10000>;
			status = "disabled";
		};

		wwdt2: watchdog@1c120000 {
			compatible = "renesas, rcar-gen5-wwdt";
			reg = <0 0x1c120000 0 0x10000>;
			status = "disabled";
		};

		wwdt3: watchdog@1c130000 {
			compatible = "renesas, rcar-gen5-wwdt";
			reg = <0 0x1c130000 0 0x10000>;
			status = "disabled";
		};

		wwdt4: watchdog@1c140000 {
			compatible = "renesas, rcar-gen5-wwdt";
			reg = <0 0x1c140000 0 0x10000>;
			status = "disabled";
		};

		wwdt5: watchdog@1c150000 {
			compatible = "renesas, rcar-gen5-wwdt";
			reg = <0 0x1c150000 0 0x10000>;
			status = "disabled";
		};

		wwdt6: watchdog@1c160000 {
			compatible = "renesas, rcar-gen5-wwdt";
			reg = <0 0x1c160000 0 0x10000>;
			status = "disabled";
		};

		wwdt7: watchdog@1c170000 {
			compatible = "renesas, rcar-gen5-wwdt";
			reg = <0 0x1c170000 0 0x10000>;
			status = "disabled";
