			power-domains = <&scmi_devpd X5H_POWER_DOMAIN_ID_UFS0>;
			clocks = <&scmi_clk X5H_CLOCK_ID_UFS0>, <&ufs0_clk>;
			clock-names = "fck", "ref_clk";
			freq-table-hz = <200000000 200000000>, <38400000 38400000>;
