		};

		a720_0: cpu@0 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x0>;
			device_type = "cpu";
			enable-method = "psci";
			i-cache-size = <0x10000>;
			i-cache-line-size = <64>;
			// 64KiB(size)/64(line-size)=1024ways/4-way set
			i-cache-sets = <256>;
			d-cache-size = <0x10000>;
			d-cache-line-size = <64>;
			// 64KiB(size)/64(line-size)=1024ways/4-way set
			d-cache-sets = <256>;
			next-level-cache = <&L2_CA720_0>;

			L2_CA720_0: l2-cache-controller-0 {
				compatible = "cache";
				cache-unified;
				cache-size = <0x80000>;
				cache-line-size = <64>;
				// 512KiB(size)/64(line-size)=8192ways/8-way set
				cache-sets = <1024>;
				cache-level = <2>;
				next-level-cache = <&L3_CA720_0>;
			};
		};

