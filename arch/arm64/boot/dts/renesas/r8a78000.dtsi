			ranges = <0x03000000 0x0 0x00100000 0x2C4 0x00000000 0x0 0x10000000>;
			#interrupt-cells = <1>;
			interrupts = <GIC_SPI 758 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 748 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 760 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 761 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 762 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 750 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 749 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &gic GIC_SPI 758 IRQ_TYPE_LEVEL_HIGH
					 0 0 0 2 &gic GIC_SPI 758 IRQ_TYPE_LEVEL_HIGH
					 0 0 0 3 &gic GIC_SPI 758 IRQ_TYPE_LEVEL_HIGH
					 0 0 0 4 &gic GIC_SPI 758 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&pcie6_bus_clk>;
			clock-names = "pcie6_bus";
			max-link-speed = <1>;
			num-lanes = <1>;
			channel-id = <1>;
			status = "disabled";
		};

