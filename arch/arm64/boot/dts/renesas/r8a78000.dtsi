		gsx: gsx@cb000000 {
			compatible = "renesas,gsx";
			reg = <0 0xcb000000 0 0x200000>;
			interrupts = <GIC_SPI 482 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&dummy_clk>;
		};

				audio_dmac0: dma-controller@ec720000 {
			compatible = "renesas,rcar-gen5-dmac";
			reg = <0 0xec720000 0 0x1000>,
			      <0 0xec700000 0 0x10000>;
			interrupts = <GIC_SPI 242 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 249 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 250 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 251 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 252 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 253 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 254 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 255 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 256 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 257 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 258 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 259 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 260 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 261 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 262 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 263 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 264 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "error",
					  "ch0", "ch1", "ch2", "ch3", "ch4",
					  "ch5", "ch6", "ch7", "ch8", "ch9",
					  "ch10", "ch11", "ch12", "ch13",
					  "ch14", "ch15";
			#dma-cells = <1>;
			dma-channels = <16>;
		};

		audio_dmac1: dma-controller@ec721000 {
			compatible = "renesas,rcar-gen5-dmac";
			reg = <0 0xec721000 0 0x1000>,
			      <0 0xec710000 0 0x10000>;
			interrupts = <GIC_SPI 244 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 265 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 266 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 267 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 268 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 269 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 270 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 271 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 272 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 273 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 274 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 275 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 276 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 277 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 278 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 279 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 280 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "error",
					  "ch0", "ch1", "ch2", "ch3", "ch4",
					  "ch5", "ch6", "ch7", "ch8", "ch9",
					  "ch10", "ch11", "ch12", "ch13",
					  "ch14", "ch15";
			#dma-cells = <1>;
			dma-channels = <16>;
		};

		rcar_sound: sound@ec500000 {
			/*
			 * #sound-dai-cells is required
			 *
			 * Single DAI : #sound-dai-cells = <0>;	<&rcar_sound>;
			 * Multi  DAI : #sound-dai-cells = <1>;	<&rcar_sound N>;
			 */
			/*
			 * #clock-cells is required for audio_clkout0/1/2/3
			 *
			 * clkout	: #clock-cells = <0>;	<&rcar_sound>;
			 * clkout0/1/2/3: #clock-cells = <1>;	<&rcar_sound N>;
			 */
			compatible =  "renesas,rcar_sound-r8a78000", "renesas,rcar_sound-gen5";
			reg =	<0 0xec500000 0 0x21004>, /* SCU */
				<0 0xec530000 0 0x140>,  /* ADG */
				<0 0xec540000 0 0x9a004>, /* SSIU */
				<0 0xec740000 0 0x1c030>;  /* Audio DMAC peri peri*/
			reg-names = "scu", "adg", "ssiu", "audmapp";

			clocks = <&ssi_dummy_clk>,
				 <&ssi_dummy_clk>, <&ssi_dummy_clk>,
				 <&ssi_dummy_clk>, <&ssi_dummy_clk>,
				 <&ssi_dummy_clk>, <&ssi_dummy_clk>,
				 <&ssi_dummy_clk>, <&ssi_dummy_clk>,
				 <&ssi_dummy_clk>, <&ssi_dummy_clk>, // of SSI
				 <&scu_dummy_clk>, <&scu_dummy_clk>,
				 <&scu_dummy_clk>, <&scu_dummy_clk>,
				 <&scu_dummy_clk>, <&scu_dummy_clk>,
				 <&scu_dummy_clk>, <&scu_dummy_clk>,
				 <&scu_dummy_clk>, <&scu_dummy_clk>, // of SRC
				 <&scu_dummy_clk>, <&scu_dummy_clk>, // of MIX
				 <&scu_dummy_clk>, <&scu_dummy_clk>, // of CTU
				 <&scu_dummy_clk>, <&scu_dummy_clk>, // of DVC
				 <&audio_clk_a>, <&audio_clk_b>,
				 <&audio_clk_c>;
			clock-names = "ssi-all",
				      "ssi.9", "ssi.8", "ssi.7", "ssi.6",
				      "ssi.5", "ssi.4", "ssi.3", "ssi.2",
				      "ssi.1", "ssi.0",
				      "src.9", "src.8", "src.7", "src.6",
				      "src.5", "src.4", "src.3", "src.2",
				      "src.1", "src.0",
				      "mix.1", "mix.0",
				      "ctu.1", "ctu.0",
				      "dvc.0", "dvc.1",
				      "clk_a", "clk_b", "clk_c";
			status = "disabled";

			rcar_sound,dvc {
				dvc0: dvc-0 {
					dmas = <&audio_dmac1 0x94>;
					dma-names = "tx";
				};
				dvc1: dvc-1 {
					dmas = <&audio_dmac1 0x92>;
					dma-names = "tx";
				};
			};

			rcar_sound,mix {
				mix0: mix-0 { };
				mix1: mix-1 { };
			};

			rcar_sound,ctu {
				ctu00: ctu-0 { };
				ctu01: ctu-1 { };
				ctu02: ctu-2 { };
				ctu03: ctu-3 { };
				ctu10: ctu-4 { };
				ctu11: ctu-5 { };
				ctu12: ctu-6 { };
				ctu13: ctu-7 { };
			};

			rcar_sound,src {
				src0: src-0 {
					interrupts = <GIC_SPI 916 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&audio_dmac0 0x13>, <&audio_dmac1 0x14>;
					dma-names = "rx", "tx";
				};
				src1: src-1 {
					interrupts = <GIC_SPI 917 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&audio_dmac0 0x11>, <&audio_dmac1 0x12>;
					dma-names = "rx", "tx";
				};
				src2: src-2 {
					interrupts = <GIC_SPI 918 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&audio_dmac0 0x0F>, <&audio_dmac1 0x10>;
					dma-names = "rx", "tx";
				};
				src3: src-3 {
					interrupts = <GIC_SPI 919 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&audio_dmac0 0x0D>, <&audio_dmac1 0x0E>;
					dma-names = "rx", "tx";
				};
				src4: src-4 {
					interrupts = <GIC_SPI 920 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&audio_dmac0 0x0B>, <&audio_dmac1 0x0C>;
					dma-names = "rx", "tx";
				};
				src5: src-5 {
					interrupts = <GIC_SPI 921 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&audio_dmac0 0x09>, <&audio_dmac1 0x0A>;
					dma-names = "rx", "tx";
				};
				src6: src-6 {
					interrupts = <GIC_SPI 922 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&audio_dmac0 0x07>, <&audio_dmac1 0x08>;
					dma-names = "rx", "tx";
				};
				src7: src-7 {
					interrupts = <GIC_SPI 923 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&audio_dmac0 0x05>, <&audio_dmac1 0x06>;
					dma-names = "rx", "tx";
				};
				src8: src-8 {
					interrupts = <GIC_SPI 924 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&audio_dmac0 0x03>, <&audio_dmac1 0x04>;
					dma-names = "rx", "tx";
				};
				src9: src-9 {
					interrupts = <GIC_SPI 925 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&audio_dmac0 0x01>, <&audio_dmac1 0x02>;
					dma-names = "rx", "tx";
				};
			};

			rcar_sound,ssiu {
				ssiu00: ssiu-0 {
					dmas = <&audio_dmac0 0x7D>, <&audio_dmac1 0x7C>;
					dma-names = "rx", "tx";
				};
				ssiu01: ssiu-1 {
					dmas = <&audio_dmac0 0x7B>, <&audio_dmac1 0x7A>;
					dma-names = "rx", "tx";
				};
				ssiu02: ssiu-2 {
					dmas = <&audio_dmac0 0x79>, <&audio_dmac1 0x78>;
					dma-names = "rx", "tx";
				};
				ssiu03: ssiu-3 {
					dmas = <&audio_dmac0 0x77>, <&audio_dmac1 0x76>;
					dma-names = "rx", "tx";
				};
				ssiu04: ssiu-4 {
					dmas = <&audio_dmac0 0x75>, <&audio_dmac1 0x74>;
					dma-names = "rx", "tx";
				};
				ssiu05: ssiu-5 {
					dmas = <&audio_dmac0 0x73>, <&audio_dmac1 0x72>;
					dma-names = "rx", "tx";
				};
				ssiu06: ssiu-6 {
					dmas = <&audio_dmac0 0x71>, <&audio_dmac1 0x70>;
					dma-names = "rx", "tx";
				};
				ssiu07: ssiu-7 {
					dmas = <&audio_dmac0 0x6F>, <&audio_dmac1 0x6E>;
					dma-names = "rx", "tx";
				};
				ssiu10: ssiu-8 {
					dmas = <&audio_dmac0 0x6D>, <&audio_dmac1 0x6C>;
					dma-names = "rx", "tx";
				};
				ssiu11: ssiu-9 {
					dmas = <&audio_dmac0 0x6B>, <&audio_dmac1 0x6A>;
					dma-names = "rx", "tx";
				};
				ssiu12: ssiu-10 {
					dmas = <&audio_dmac0 0x69>, <&audio_dmac1 0x68>;
					dma-names = "rx", "tx";
				};
				ssiu13: ssiu-11 {
					dmas = <&audio_dmac0 0x67>, <&audio_dmac1 0x66>;
					dma-names = "rx", "tx";
				};
				ssiu14: ssiu-12 {
					dmas = <&audio_dmac0 0x65>, <&audio_dmac1 0x64>;
