#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/power/r8a78000-power.h>
#include <dt-bindings/clock/r8a78000-scmi-clock.h>
#include <dt-bindings/clock/r8a78000-scmi-reset.h>

#define GIC_MULTI_VIEW

/ {
	compatible = "renesas,r8a78000";
	#address-cells = <2>;
	#size-cells = <2>;

	dummy_clk: dummy_clk {
		compatible = "fixed-clock";
		clock-frequency = <0>;
		#clock-cells = <0>;
	};

	can_clk: can {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <0>;
	};

	canxl_clk: canxl_clk {
		compatible = "fixed-clock";
		clock-frequency = <160000000>;
		#clock-cells = <0>;
	};
	cpus {
		#address-cells = <2>;
		#size-cells = <0>;

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&a720_0>;
				};
				core1 {
					cpu = <&a720_1>;
				};
				core2 {
					cpu = <&a720_2>;
				};
				core3 {
					cpu = <&a720_3>;
				};
			};

			cluster1 {
