			rcar_sound,ssi {
				ssi0: ssi-0 {
					interrupts = <GIC_SPI 896 IRQ_TYPE_LEVEL_HIGH>;
				};
				ssi1: ssi-1 {
					interrupts = <GIC_SPI 897 IRQ_TYPE_LEVEL_HIGH>;
				};
				ssi2: ssi-2 {
					interrupts = <GIC_SPI 898 IRQ_TYPE_LEVEL_HIGH>;
				};
				ssi3: ssi-3 {
					interrupts = <GIC_SPI 899 IRQ_TYPE_LEVEL_HIGH>;
				};
				ssi4: ssi-4 {
					interrupts = <GIC_SPI 900 IRQ_TYPE_LEVEL_HIGH>;
				};
				ssi5: ssi-5 {
					interrupts = <GIC_SPI 901 IRQ_TYPE_LEVEL_HIGH>;
				};
				ssi6: ssi-6 {
					interrupts = <GIC_SPI 902 IRQ_TYPE_LEVEL_HIGH>;
				};
				ssi7: ssi-7 {
					interrupts = <GIC_SPI 903 IRQ_TYPE_LEVEL_HIGH>;
				};
				ssi8: ssi-8 {
					interrupts = <GIC_SPI 904 IRQ_TYPE_LEVEL_HIGH>;
				};
				ssi9: ssi-9 {
					interrupts = <GIC_SPI 905 IRQ_TYPE_LEVEL_HIGH>;
				};
			};
		};

		/* ADG Audio Clock Generator */
		adg0: adg@ec530000 {
			compatible = "generic-uio";
			reg = <0x0 0xec530000 0x0 0x1000>;
			linux,uio-name = "adg_00";
		};

		audio_dmac2: dma-controller@ed720000 {
			compatible = "renesas,rcar-gen5-dmac";
			reg = <0 0xed720000 0 0x1000>,
			      <0 0xed700000 0 0x10000>;
			interrupts = <GIC_SPI 246 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 281 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 282 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 283 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 284 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 285 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 286 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 287 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 288 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 289 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 290 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 291 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 292 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 293 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 294 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 295 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 296 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "error",
					  "ch0", "ch1", "ch2", "ch3", "ch4",
					  "ch5", "ch6", "ch7", "ch8", "ch9",
					  "ch10", "ch11", "ch12", "ch13",
					  "ch14", "ch15";
			#dma-cells = <1>;
			dma-channels = <16>;
		};

		audio_dmac3: dma-controller@ed721000 {
			compatible = "renesas,rcar-gen5-dmac";
			reg = <0 0xed721000 0 0x1000>,
			      <0 0xed710000 0 0x10000>;
			interrupts = <GIC_SPI 248 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 297 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 298 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 299 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 300 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 301 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 302 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 303 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 304 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 305 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 306 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 307 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 308 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 309 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 310 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 311 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 312 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "error",
					  "ch0", "ch1", "ch2", "ch3", "ch4",
					  "ch5", "ch6", "ch7", "ch8", "ch9",
					  "ch10", "ch11", "ch12", "ch13",
					  "ch14", "ch15";
			#dma-cells = <1>;
			dma-channels = <16>;
		};

		adg1: adg@ed530000 {
			compatible = "generic-uio";
			reg = <0x0 0xed530000 0x0 0x1000>;
			linux,uio-name = "adg_01";
		};

		/* IPMMU devices */
		ipmmu_vc: iommu@eedc0000 {
			compatible = "renesas,ipmmu-r8a779a0";
			reg = <0x0 0xeedc0000 0x0 0x20000>;
			renesas,ipmmu-main = <&ipmmu_mm 12>;
			#iommu-cells = <1>;
			status = "disabled";
		};

		ipmmu_vi0: iommu@eed80000 {
			compatible = "renesas,ipmmu-r8a779g0";
			reg = <0x0 0xeed80000 0x0 0x200000>;
			renesas,ipmmu-main = <&ipmmu_mm 3>;
			#iommu-cells = <1>;
			status = "disabled";
		};

		ipmmu_mm: iommu@f8000000 {
			compatible = "renesas,ipmmu-r8a779g0";
			reg = <0x0 0xf8000000 0x0 0x200000>;
			interrupts = <GIC_SPI 210 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 211 IRQ_TYPE_LEVEL_HIGH>;
			#iommu-cells = <1>;
			status = "disabled";
		};

		/* Dummy and stub devices */
		dummy_00: dummy@fff50000 {
			compatible = "generic-uio";
			reg = <0x0 0xfff50000 0x0 0x1000>;
			interrupts = <GIC_SPI 128 IRQ_TYPE_LEVEL_HIGH>;
			linux,uio-name = "dummy_00";
		};

		aoa_dummy_00: aoa-dummy@fff52000 {
			compatible = "generic-uio";
			reg = <0x0 0xfff52000 0x0 0x10000>;
			linux,uio-name = "aoa_dummy_00";
		};

		stub_pad_reset0: stub-pad-reset@fff74000 {
			compatible = "generic-uio";
			reg = <0x0 0xfff74000 0x0 0x10000>;
			linux,uio-name = "stub_pad_reset_00";
		};

		stub_pad_reset1: stub-pad-reset@fff75000 {
			compatible = "generic-uio";
			reg = <0x0 0xfff75000 0x0 0x10000>;
			linux,uio-name = "stub_pad_reset_10";
		};

		cr52_rproc0: cr52_0 {
			compatible = "renesas,rcar-gen5-rproc";
			memory-region = <&cr52_ram0>;
			renesas,mfis-channel = <0>;
			status = "disabled";
		};

		cr52_rproc1: cr52_1 {
			compatible = "renesas,rcar-gen5-rproc";
			memory-region = <&cr52_ram1>;
			renesas,mfis-channel = <1>;
			status = "disabled";
		};

		cr52_rproc2: cr52_2 {
			compatible = "renesas,rcar-gen5-rproc";
			memory-region = <&cr52_ram2>;
			renesas,mfis-channel = <2>;
			status = "disabled";
		};

		mfis: mfis@18800000 {
			compatible = "renesas,mfis";
			reg = <0x0 0x18800000 0x0 0x10000>, <0x0 0x189e0900 0x0 0x4>;
			reg-names = "io_base", "unlock_reg";
			interrupts = <GIC_SPI 101 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 103 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 105 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 107 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 109 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 111 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 113 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 115 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "eicr0", "eicr1", "eicr2", "eicr3", "eicr4", "eicr5", "eicr6", "eicr7";
			renesas,mfis-channels = <0 1 2 3>;
			status = "disabled";
		};

		rpmsg_shm0: rpmsg_shm@0 {
			compatible = "generic-uio";
			reg = <0x0 0x96600000 0x0 0x50000>;
			linux,uio-name = "rpmsg_shm0";
			status = "disabled";
		};

		rpmsg_ipi0: rpmsg_ipi@0 {
			compatible = "generic-uio";
			reg = <0x0 0x18800000 0x0 0x1000>;
			interrupts = <GIC_SPI 101 IRQ_TYPE_LEVEL_HIGH>;
			linux,uio-name = "rpmsg_ipi0";
			status = "disabled";
		};

		rpmsg_shm1: rpmsg_shm@1 {
			compatible = "generic-uio";
			reg = <0x0 0x96650000 0x0 0x50000>;
			linux,uio-name = "rpmsg_shm1";
			status = "disabled";
		};

		rpmsg_ipi1: rpmsg_ipi@1 {
			compatible = "generic-uio";
			reg = <0x0 0x18801000 0x0 0x1000>;
			interrupts = <GIC_SPI 103 IRQ_TYPE_LEVEL_HIGH>;
			linux,uio-name = "rpmsg_ipi1";
			status = "disabled";
		};

		rpmsg_shm2: rpmsg_shm@2 {
			compatible = "generic-uio";
			reg = <0x0 0x966a0000 0x0 0x50000>;
			linux,uio-name = "rpmsg_shm2";
			status = "disabled";
		};

		rpmsg_ipi2: rpmsg_ipi@2 {
			compatible = "generic-uio";
			reg = <0x0 0x18802000 0x0 0x1000>;
			interrupts = <GIC_SPI 105 IRQ_TYPE_LEVEL_HIGH>;
			linux,uio-name = "rpmsg_ipi2";
			status = "disabled";
		};

	};

	flash@160000000 {
		compatible = "cfi-flash";
		reg = <0x1 0x60000000 0x0 0x4800000>,
		      <0x1 0x64800000 0x0 0x4800000>;
		bank-width = <4>;
	};

	rtc: rtc@169010000 {
		compatible = "arm,pl031", "arm,primecell";
		reg = <0x1 0x69010000 0x0 0x1000>;
		interrupts = <GIC_SPI 487 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&apb_pclk>;
		clock-names = "apb_pclk";
	};

	fw_cfg: fw-cfg@169020000 {
		compatible = "qemu,fw-cfg-mmio";
		reg = <0x1 0x69020000 0x0 0x18>;
		dma-coherent;
	};

	gpio: gpio@169030000 {
		compatible = "arm,pl061", "arm,primecell";
		reg = <0x1 0x69030000 0x0 0x1000>;
		#gpio-cells = <2>;
		gpio-controller;
		interrupts = <GIC_SPI 488 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&apb_pclk>;
		clock-names = "apb_pclk";
	};

	/* VirtIO MMIO devices */
	virtio_mmio@16a000000 {
		compatible = "virtio,mmio";
		reg = <0x1 0x6a000000 0x0 0x200>;
		interrupts = <GIC_SPI 229 IRQ_TYPE_EDGE_RISING>;
		dma-coherent;
	};

	virtio_mmio@16a000200 {
		compatible = "virtio,mmio";
		reg = <0x1 0x6a000200 0x0 0x200>;
		interrupts = <GIC_SPI 230 IRQ_TYPE_EDGE_RISING>;
		dma-coherent;
	};

