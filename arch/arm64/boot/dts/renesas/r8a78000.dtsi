				 <&scmi_clk X5H_CLOCK_ID_RGX_MERCER7>,
				 <&scmi_clk X5H_CLOCK_ID_RGX_TEXAS2>,
				 <&scmi_clk X5H_CLOCK_ID_RGX_TEXAS3>,
				 <&scmi_clk X5H_CLOCK_ID_RGX_SWIFT4>,
				 <&scmi_clk X5H_CLOCK_ID_RGX_SWIFT5>,
				 <&scmi_clk X5H_CLOCK_ID_RGX_SWIFT6>,
				 <&scmi_clk X5H_CLOCK_ID_RGX_SWIFT7>;
			clock-names = "rgx_jones0", "rgx_mercer0", "rgx_mercer1", "rgx_mercer2",
				      "rgx_mercer3", "rgx_texas0", "rgx_texas1", "rgx_swift0",
				      "rgx_swift1", "rgx_swift2", "rgx_swift3", "rgx_jones1",
				      "rgx_mercer4", "rgx_mercer5", "rgx_mercer6", "rgx_mercer7",
				      "rgx_texas2", "rgx_texas3", "rgx_swift4", "rgx_swift5",
				      "rgx_swift6", "rgx_swift7";
			power-domains = <&scmi_devpd X5H_POWER_DOMAIN_ID_GPCA0>,
					<&scmi_devpd X5H_POWER_DOMAIN_ID_GPCA1>,
					<&scmi_devpd X5H_POWER_DOMAIN_ID_GPCB0>,
					<&scmi_devpd X5H_POWER_DOMAIN_ID_GPCB1>;
			status = "disabled";
		};

		rcar_sound: sound@ec500000 {
			/*
			 * #sound-dai-cells is required
			 *
			 * Single DAI : #sound-dai-cells = <0>;	<&rcar_sound>;
			 * Multi  DAI : #sound-dai-cells = <1>;	<&rcar_sound N>;
			 */
			/*
			 * #clock-cells is required for audio_clkout0/1/2/3
			 *
			 * clkout	: #clock-cells = <0>;	<&rcar_sound>;
			 * clkout0/1/2/3: #clock-cells = <1>;	<&rcar_sound N>;
			 */
			compatible =  "renesas,rcar_sound-r8a78000", "renesas,rcar_sound-gen5";
			reg =	<0 0xec500000 0 0x21004>, /* SCU */
				<0 0xec530000 0 0x140>,  /* ADG */
				<0 0xec540000 0 0x9a004>, /* SSIU */
				<0 0xec740000 0 0x1c030>;  /* Audio DMAC peri peri*/
			reg-names = "scu", "adg", "ssiu", "audmapp";

			clocks = <&scmi_clk X5H_CLOCK_ID_ADG0>, <&scmi_clk X5H_CLOCK_ID_SSI0>,
				 <&scmi_clk X5H_CLOCK_ID_SSI09>, <&scmi_clk X5H_CLOCK_ID_SSI08>,
				 <&scmi_clk X5H_CLOCK_ID_SSI07>, <&scmi_clk X5H_CLOCK_ID_SSI06>,
				 <&scmi_clk X5H_CLOCK_ID_SSI05>, <&scmi_clk X5H_CLOCK_ID_SSI04>,
				 <&scmi_clk X5H_CLOCK_ID_SSI03>, <&scmi_clk X5H_CLOCK_ID_SSI02>,
				 <&scmi_clk X5H_CLOCK_ID_SSI01>, <&scmi_clk X5H_CLOCK_ID_SSI00>,
				 <&scmi_clk X5H_CLOCK_ID_SCU0>,
				 <&scmi_clk X5H_CLOCK_ID_SRC09>, <&scmi_clk X5H_CLOCK_ID_SRC08>,
				 <&scmi_clk X5H_CLOCK_ID_SRC07>, <&scmi_clk X5H_CLOCK_ID_SRC06>,
				 <&scmi_clk X5H_CLOCK_ID_SRC05>, <&scmi_clk X5H_CLOCK_ID_SRC04>,
				 <&scmi_clk X5H_CLOCK_ID_SRC03>, <&scmi_clk X5H_CLOCK_ID_SRC02>,
				 <&scmi_clk X5H_CLOCK_ID_SRC01>, <&scmi_clk X5H_CLOCK_ID_SRC00>,
				 <&scmi_clk X5H_CLOCK_ID_SCU01>, <&scmi_clk X5H_CLOCK_ID_SCU00>,
				 <&scmi_clk X5H_CLOCK_ID_SCU01>, <&scmi_clk X5H_CLOCK_ID_SCU00>,
				 <&scmi_clk X5H_CLOCK_ID_DVC00>, <&scmi_clk X5H_CLOCK_ID_DVC01>,
				 <&scmi_clk X5H_CLOCK_ID_APD00>, <&scmi_clk X5H_CLOCK_ID_APD01>,
				 <&audio_clk_a>, <&audio_clk_b>,
				 <&audio_clk_c>;
			clock-names = "adg", "ssi-all",
				      "ssi.9", "ssi.8", "ssi.7", "ssi.6",
				      "ssi.5", "ssi.4", "ssi.3", "ssi.2",
				      "ssi.1", "ssi.0",
				      "scu-all",
				      "src.9", "src.8", "src.7", "src.6",
				      "src.5", "src.4", "src.3", "src.2",
				      "src.1", "src.0",
				      "mix.1", "mix.0",
				      "ctu.1", "ctu.0",
				      "dvc.0", "dvc.1",
				      "dmapp.0", "dmapp.1",
				      "clk_a", "clk_b", "clk_c";
			status = "disabled";

			rcar_sound,dvc {
				dvc0: dvc-0 {
					dmas = <&audio_dmac1 0x94>;
					dma-names = "tx";
				};
				dvc1: dvc-1 {
					dmas = <&audio_dmac1 0x92>;
					dma-names = "tx";
				};
			};

			rcar_sound,mix {
				mix0: mix-0 { };
				mix1: mix-1 { };
			};

			rcar_sound,ctu {
				ctu00: ctu-0 { };
				ctu01: ctu-1 { };
				ctu02: ctu-2 { };
				ctu03: ctu-3 { };
				ctu10: ctu-4 { };
				ctu11: ctu-5 { };
				ctu12: ctu-6 { };
				ctu13: ctu-7 { };
			};

			rcar_sound,src {
				src0: src-0 {
					interrupts = <GIC_SPI 916 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&audio_dmac0 0x13>, <&audio_dmac1 0x14>;
					dma-names = "rx", "tx";
				};
				src1: src-1 {
					interrupts = <GIC_SPI 917 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&audio_dmac0 0x11>, <&audio_dmac1 0x12>;
					dma-names = "rx", "tx";
				};
				src2: src-2 {
					interrupts = <GIC_SPI 918 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&audio_dmac0 0x0F>, <&audio_dmac1 0x10>;
					dma-names = "rx", "tx";
				};
				src3: src-3 {
					interrupts = <GIC_SPI 919 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&audio_dmac0 0x0D>, <&audio_dmac1 0x0E>;
					dma-names = "rx", "tx";
				};
				src4: src-4 {
					interrupts = <GIC_SPI 920 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&audio_dmac0 0x0B>, <&audio_dmac1 0x0C>;
					dma-names = "rx", "tx";
				};
				src5: src-5 {
					interrupts = <GIC_SPI 921 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&audio_dmac0 0x09>, <&audio_dmac1 0x0A>;
					dma-names = "rx", "tx";
				};
				src6: src-6 {
					interrupts = <GIC_SPI 922 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&audio_dmac0 0x07>, <&audio_dmac1 0x08>;
					dma-names = "rx", "tx";
				};
				src7: src-7 {
					interrupts = <GIC_SPI 923 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&audio_dmac0 0x05>, <&audio_dmac1 0x06>;
					dma-names = "rx", "tx";
				};
				src8: src-8 {
					interrupts = <GIC_SPI 924 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&audio_dmac0 0x03>, <&audio_dmac1 0x04>;
					dma-names = "rx", "tx";
				};
				src9: src-9 {
					interrupts = <GIC_SPI 925 IRQ_TYPE_LEVEL_HIGH>;
					dmas = <&audio_dmac0 0x01>, <&audio_dmac1 0x02>;
					dma-names = "rx", "tx";
				};
			};

			rcar_sound,ssiu {
				ssiu00: ssiu-0 {
					dmas = <&audio_dmac0 0x7D>, <&audio_dmac1 0x7C>;
					dma-names = "rx", "tx";
				};
				ssiu01: ssiu-1 {
					dmas = <&audio_dmac0 0x7B>, <&audio_dmac1 0x7A>;
					dma-names = "rx", "tx";
				};
				ssiu02: ssiu-2 {
