					dma-names = "rx", "tx";
				};
				ssiu05: ssiu-5 {
					dmas = <&audio_dmac0 0x73>, <&audio_dmac1 0x72>;
					dma-names = "rx", "tx";
				};
				ssiu06: ssiu-6 {
					dmas = <&audio_dmac0 0x71>, <&audio_dmac1 0x70>;
					dma-names = "rx", "tx";
				};
				ssiu07: ssiu-7 {
					dmas = <&audio_dmac0 0x6F>, <&audio_dmac1 0x6E>;
					dma-names = "rx", "tx";
				};
				ssiu10: ssiu-8 {
					dmas = <&audio_dmac0 0x6D>, <&audio_dmac1 0x6C>;
					dma-names = "rx", "tx";
				};
				ssiu11: ssiu-9 {
					dmas = <&audio_dmac0 0x6B>, <&audio_dmac1 0x6A>;
					dma-names = "rx", "tx";
				};
				ssiu12: ssiu-10 {
					dmas = <&audio_dmac0 0x69>, <&audio_dmac1 0x68>;
					dma-names = "rx", "tx";
				};
				ssiu13: ssiu-11 {
					dmas = <&audio_dmac0 0x67>, <&audio_dmac1 0x66>;
					dma-names = "rx", "tx";
				};
				ssiu14: ssiu-12 {
					dmas = <&audio_dmac0 0x65>, <&audio_dmac1 0x64>;
					dma-names = "rx", "tx";
				};
				ssiu15: ssiu-13 {
					dmas = <&audio_dmac0 0x63>, <&audio_dmac1 0x62>;
					dma-names = "rx", "tx";
				};
				ssiu16: ssiu-14 {
					dmas = <&audio_dmac0 0x61>, <&audio_dmac1 0x60>;
					dma-names = "rx", "tx";
				};
				ssiu17: ssiu-15 {
					dmas = <&audio_dmac0 0x5F>, <&audio_dmac1 0x5E>;
					dma-names = "rx", "tx";
				};
				ssiu20: ssiu-16 {
					dmas = <&audio_dmac0 0x5D>, <&audio_dmac1 0x5C>;
