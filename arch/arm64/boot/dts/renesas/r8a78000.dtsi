		eth_pcs: phy@c9c50000 {
			compatible = "renesas,r8a78000-ether-pcs";
			reg = <0 0xc9c50000 0 0x4000>;
			#phy-cells = <1>;
			power-domains = <&scmi_devpd X5H_POWER_DOMAIN_ID_MPP2>;
			clocks = <&scmi_clk X5H_CLOCK_ID_XPCS0>,
				     <&scmi_clk X5H_CLOCK_ID_XPCS1>,
				     <&scmi_clk X5H_CLOCK_ID_XPCS2>,
