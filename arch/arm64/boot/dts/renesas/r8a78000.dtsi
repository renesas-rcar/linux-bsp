		dma-coherent;
	};

	virtio_mmio@16a000e00 {
		compatible = "virtio,mmio";
		reg = <0x1 0x6a000e00 0x0 0x200>;
		interrupts = <GIC_SPI 236 IRQ_TYPE_EDGE_RISING>;
		dma-coherent;
	};

	virtio_mmio@16a001000 {
		compatible = "virtio,mmio";
		reg = <0x1 0x6a001000 0x0 0x200>;
		interrupts = <GIC_SPI 489 IRQ_TYPE_EDGE_RISING>;
		dma-coherent;
	};

	platform_bus: platform-bus@16c000000 {
		compatible = "qemu,platform", "simple-bus";
		#size-cells = <1>;
		#address-cells = <1>;
		ranges = <0x0 0x1 0x6c000000 0x2000000>;
		interrupt-parent = <&gic>;
	};

	pcie: pcie@16f000100 {
		compatible = "pci-host-ecam-generic";
		device_type = "pci";
		#address-cells = <3>;
		#size-cells = <2>;
		linux,pci-domain = <0>;
		bus-range = <0x0 0xff>;
		dma-coherent;
		reg = <0x40 0x10000000 0x0 0x10000000>;
		ranges = <0x1000000 0x0 0x0 0x1 0x6f000200 0x0 0x1000>,
			 <0x2000000 0x1 0x6f000100 0x1 0x6f000100 0x0 0x100>,
			 <0x3000000 0x80 0x0 0x80 0x0 0x80 0x0>;
		#interrupt-cells = <1>;
		interrupt-map-mask = <0x1800 0x0 0x0 0x7>;
		interrupt-map = <0x0 0x0 0x0 0x1 &gic 0x0 0x0 0x0 0x1ee IRQ_TYPE_LEVEL_HIGH>,
				<0x0 0x0 0x0 0x2 &gic 0x0 0x0 0x0 0x1ef IRQ_TYPE_LEVEL_HIGH>,
				<0x0 0x0 0x0 0x3 &gic 0x0 0x0 0x0 0x1f0 IRQ_TYPE_LEVEL_HIGH>,
				<0x0 0x0 0x0 0x4 &gic 0x0 0x0 0x0 0x1f1 IRQ_TYPE_LEVEL_HIGH>,
				<0x800 0x0 0x0 0x1 &gic 0x0 0x0 0x0 0x1ef IRQ_TYPE_LEVEL_HIGH>,
				<0x800 0x0 0x0 0x2 &gic 0x0 0x0 0x0 0x1f0 IRQ_TYPE_LEVEL_HIGH>,
				<0x800 0x0 0x0 0x3 &gic 0x0 0x0 0x0 0x1f1 IRQ_TYPE_LEVEL_HIGH>,
				<0x800 0x0 0x0 0x4 &gic 0x0 0x0 0x0 0x1ee IRQ_TYPE_LEVEL_HIGH>,
				<0x1000 0x0 0x0 0x1 &gic 0x0 0x0 0x0 0x1f0 IRQ_TYPE_LEVEL_HIGH>,
				<0x1000 0x0 0x0 0x2 &gic 0x0 0x0 0x0 0x1f1 IRQ_TYPE_LEVEL_HIGH>,
				<0x1000 0x0 0x0 0x3 &gic 0x0 0x0 0x0 0x1ee IRQ_TYPE_LEVEL_HIGH>,
				<0x1000 0x0 0x0 0x4 &gic 0x0 0x0 0x0 0x1ef IRQ_TYPE_LEVEL_HIGH>,
				<0x1800 0x0 0x0 0x1 &gic 0x0 0x0 0x0 0x1f1 IRQ_TYPE_LEVEL_HIGH>,
				<0x1800 0x0 0x0 0x2 &gic 0x0 0x0 0x0 0x1ee IRQ_TYPE_LEVEL_HIGH>,
				<0x1800 0x0 0x0 0x3 &gic 0x0 0x0 0x0 0x1ef IRQ_TYPE_LEVEL_HIGH>,
				<0x1800 0x0 0x0 0x4 &gic 0x0 0x0 0x0 0x1f0 IRQ_TYPE_LEVEL_HIGH>;
		msi-map = <0x0 &gic_its 0x0 0x10000>;
	};

	snps-csi2cam0@c4602000 {
		compatible = "snps,csi2cam";
		reg = <0 0xc4602000 0 0x100>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				csi2cam_out0: endpoint {
					//clock-lanes = <0>;
					data-lanes = <1>;
					remote-endpoint = <&csi40_in>;
				};
			};
		};
	};

	snps-csi2cam1@c4612000 {
		compatible = "snps,csi2cam";
		reg = <0 0xc4612000 0 0x100>;

		ports {
