#include <dt-bindings/interrupt-controller/arm-gic.h>

#define GIC_MULTI_VIEW

/ {
	compatible = "renesas,r8a78000";
	#address-cells = <2>;
	#size-cells = <2>;

	cpus {
		#address-cells = <2>;
		#size-cells = <0>;

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&a720_0>;
				};
				core1 {
					cpu = <&a720_1>;
				};
				core2 {
					cpu = <&a720_2>;
				};
				core3 {
					cpu = <&a720_3>;
				};
			};

			cluster1 {
				core0 {
					cpu = <&a720_4>;
				};
				core1 {
					cpu = <&a720_5>;
				};
				core2 {
					cpu = <&a720_6>;
				};
				core3 {
					cpu = <&a720_7>;
				};
			};

			cluster2 {
				core0 {
					cpu = <&a720_8>;
				};
				core1 {
					cpu = <&a720_9>;
				};
				core2 {
					cpu = <&a720_10>;
				};
				core3 {
					cpu = <&a720_11>;
				};
			};

			cluster3 {
				core0 {
					cpu = <&a720_12>;
				};
				core1 {
					cpu = <&a720_13>;
				};
				core2 {
					cpu = <&a720_14>;
				};
				core3 {
					cpu = <&a720_15>;
				};
			};

			cluster4 {
				core0 {
					cpu = <&a720_16>;
				};
				core1 {
					cpu = <&a720_17>;
				};
				core2 {
					cpu = <&a720_18>;
				};
				core3 {
					cpu = <&a720_19>;
				};
			};

			cluster5 {
				core0 {
					cpu = <&a720_20>;
				};
				core1 {
					cpu = <&a720_21>;
				};
				core2 {
					cpu = <&a720_22>;
				};
				core3 {
					cpu = <&a720_23>;
				};
			};

			cluster6 {
				core0 {
					cpu = <&a720_24>;
				};
				core1 {
					cpu = <&a720_25>;
				};
				core2 {
					cpu = <&a720_26>;
				};
				core3 {
					cpu = <&a720_27>;
				};
			};

			cluster7 {
				core0 {
					cpu = <&a720_28>;
				};
				core1 {
					cpu = <&a720_29>;
				};
				core2 {
					cpu = <&a720_30>;
				};
				core3 {
					cpu = <&a720_31>;
				};
			};
		};

		a720_0: cpu@0 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x0>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_0>;
			enable-method = "psci";
		};

		a720_1: cpu@100 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x100>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_0>;
			enable-method = "psci";
		};

		a720_2: cpu@200 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x200>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_0>;
			enable-method = "psci";
		};

		a720_3: cpu@300 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x300>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_0>;
			enable-method = "psci";
		};

		a720_4: cpu@10000 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x10000>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_1>;
			enable-method = "psci";
		};

		a720_5: cpu@10100 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x10100>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_1>;
			enable-method = "psci";
		};

		a720_6: cpu@10200 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x10200>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_1>;
			enable-method = "psci";
		};

		a720_7: cpu@10300 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x10300>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_1>;
			enable-method = "psci";
		};

		a720_8: cpu@20000 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x20000>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_2>;
			enable-method = "psci";
		};

		a720_9: cpu@20100 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x20100>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_2>;
			enable-method = "psci";
		};

		a720_10: cpu@20200 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x20200>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_2>;
			enable-method = "psci";
		};

		a720_11: cpu@20300 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x20300>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_2>;
			enable-method = "psci";
		};

		a720_12: cpu@30000 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x30000>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_3>;
			enable-method = "psci";
		};

		a720_13: cpu@30100 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x30100>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_3>;
			enable-method = "psci";
		};

		a720_14: cpu@30200 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x30200>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_3>;
			enable-method = "psci";
		};

		a720_15: cpu@30300 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x30300>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_3>;
			enable-method = "psci";
		};

		a720_16: cpu@40000 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x40000>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_4>;
			enable-method = "psci";
		};

		a720_17: cpu@40100 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x40100>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_4>;
			enable-method = "psci";
		};

		a720_18: cpu@40200 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x40200>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_4>;
			enable-method = "psci";
		};

		a720_19: cpu@40300 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x40300>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_4>;
			enable-method = "psci";
		};

		a720_20: cpu@50000 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x50000>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_5>;
			enable-method = "psci";
		};

		a720_21: cpu@50100 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x50100>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_5>;
			enable-method = "psci";
		};

		a720_22: cpu@50200 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x50200>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_5>;
			enable-method = "psci";
		};

		a720_23: cpu@50300 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x50300>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_5>;
			enable-method = "psci";
		};

		a720_24: cpu@60000 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x60000>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_6>;
			enable-method = "psci";
		};

		a720_25: cpu@60100 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x60100>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_6>;
			enable-method = "psci";
		};

		a720_26: cpu@60200 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x60200>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_6>;
			enable-method = "psci";
		};

		a720_27: cpu@60300 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x60300>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_6>;
			enable-method = "psci";
		};

		a720_28: cpu@70000 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x70000>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_7>;
			enable-method = "psci";
		};

		a720_29: cpu@70100 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x70100>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_7>;
			enable-method = "psci";
		};

		a720_30: cpu@70200 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x70200>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_7>;
			enable-method = "psci";
		};

		a720_31: cpu@70300 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x70300>;
			device_type = "cpu";
			next-level-cache = <&L3_CA720_7>;
			enable-method = "psci";
		};

		L3_CA720_0: cache-controller-0 {
			compatible = "cache";
			cache-unified;
			cache-level = <3>;
		};

		L3_CA720_1: cache-controller-1 {
			compatible = "cache";
			cache-unified;
			cache-level = <3>;
		};

		L3_CA720_2: cache-controller-2 {
			compatible = "cache";
			cache-unified;
			cache-level = <3>;
		};

		L3_CA720_3: cache-controller-3 {
			compatible = "cache";
			cache-unified;
			cache-level = <3>;
		};

		L3_CA720_4: cache-controller-4 {
			compatible = "cache";
			cache-unified;
			cache-level = <3>;
		};

		L3_CA720_5: cache-controller-5 {
			compatible = "cache";
			cache-unified;
			cache-level = <3>;
		};

		L3_CA720_6: cache-controller-6 {
			compatible = "cache";
			cache-unified;
			cache-level = <3>;
		};

		L3_CA720_7: cache-controller-7 {
			compatible = "cache";
			cache-unified;
			cache-level = <3>;
		};
	};

	extal_clk: extal {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		/* This value must be overridden by the board */
		clock-frequency = <0>;
	};

	extalr_clk: extalr {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		/* This value must be overridden by the board */
		clock-frequency = <0>;
	};

	firmware {
		scmi {
			compatible = "arm,scmi";
			mbox-names = "tx","rx";
			mboxes = <&mailbox 0 &mailbox 1>;
			shmem = <&cpu_scp_lpri0 &cpu_scp_hpri0>;
			#address-cells = <1>;
			#size-cells = <0>;

			scmi_devpd: protocol@11 {
				reg = <0x11>;
				#power-domain-cells = <1>;
			};

			/* TODO: scmi_clk, scmi_reset */
		};
	};

	pmu_a720 {
		compatible = "arm,cortex-a720-pmu";
		interrupts-extended = <&gic GIC_PPI 7 IRQ_TYPE_LEVEL_LOW>;
	};

	psci {
		compatible = "arm,psci-1.0", "arm,psci-0.2";
		method = "smc";
	};

	/* In the early phase, there is no clock control support,
	 * so assume that the clocks are enabled by default.
	 * Therefore, dummy clocks are used.
	 */
	dummy_clk_sgasyncd4: dummy_clk_sgasyncd4 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <266660000>;
	};

	dummy_clk_wdt: dummy_clk_wdt {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32800>;
		clock-output-names = "watchdog";
	};

	rsw3_clk: rsw3_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <0>;
	};

	dummy_clk_wcrc: dummy_clk_wcrc {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <0>;
	};

	/* External SCIF clock - to be overridden by boards that provide it */
	scif_clk: scif {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <0>;
	};

	/* External PCIe clock - can be overridden by the board */
	pcie4_bus_clk: pcie4_bus {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <100000000>;
	};

	soc: soc {
		compatible = "simple-bus";
		interrupt-parent = <&gic>;
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		mfis: mfis@18800000 {
			compatible = "renesas,mfis";
			reg = <0x0 0x18800000 0x0 0x1000>,
			      <0x0 0x18801000 0x0 0x1000>,
			      <0x0 0x18802000 0x0 0x1000>,
			      <0x0 0x18803000 0x0 0x1000>,
			      <0x0 0x18804000 0x0 0x1000>,
			      <0x0 0x18805000 0x0 0x1000>,
			      <0x0 0x18806000 0x0 0x1000>,
			      <0x0 0x18807000 0x0 0x1000>,
			      <0x0 0x189e0900 0x0 0x4>;
			reg-names = "ch0", "ch1", "ch2", "ch3",
				    "ch4", "ch5", "ch6", "ch7",
				     "unlock_reg";
			interrupts = <GIC_SPI 101 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 103 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 105 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 107 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 109 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 111 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 113 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 115 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "ch0", "ch1", "ch2", "ch3",
					  "ch4", "ch5", "ch6", "ch7";
			renesas,mfis-channels = <0 1 2>;
			status = "disabled";
		};

		mailbox: mfis_mbox@18842000 {
			compatible = "renesas,mfis-mbox";
			#mbox-cells = <1>;
			reg = <0x0 0x18842004 0x0 0x4>,
			      <0x0 0x18842000 0x0 0x4>;
			interrupts = <GIC_SPI 4362 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
		};

		mfis_lock@189e0000 {
			compatible = "renesas,mfis-lock-r8a78000",
				     "renesas,mfis-lock-gen5";
			reg = <0 0x189e0000 0 0x900>, <0x0 0x189e0900 0x0 0x4>;
			reg-names = "io_base", "unlock_reg";
			#hwlock-cells = <1>;
		};

		prr: chipid@189e0044 {
			compatible = "renesas,prr";
			reg = <0 0x189e0044 0 4>;
		};

		/* The Arm GIC-700AE - View 1 */
		gic: interrupt-controller@39000000 {
			compatible = "arm,gic-v3";
			#interrupt-cells = <3>;
			#address-cells = <0>;
			interrupt-controller;
			redistributor-stride = <0x0 0x40000>;
#ifndef GIC_MULTI_VIEW /* Single-view */
			#redistributor-regions = <1>;
			reg = <0x0 0x39000000 0 0x20000>,
			      <0x0 0x39080000 0 0x810000>;
#else	/* Multi-view */
			#redistributor-regions = <32>;
			reg = <0x0 0x39000000 0x0 0x20000>, // GICD
			      <0x0 0x39080000 0x0 0x40000>, // GICR Core0
			      <0x0 0x390C0000 0x0 0x40000>, // GICR Core1
			      <0x0 0x39100000 0x0 0x40000>, // GICR Core2
			      <0x0 0x39140000 0x0 0x40000>, // GICR Core3
			      <0x0 0x39180000 0x0 0x40000>, // GICR Core4
			      <0x0 0x391C0000 0x0 0x40000>, // GICR Core5
			      <0x0 0x39200000 0x0 0x40000>, // GICR Core6
			      <0x0 0x39240000 0x0 0x40000>, // GICR Core7
			      <0x0 0x39280000 0x0 0x40000>, // GICR Core8
			      <0x0 0x392C0000 0x0 0x40000>, // GICR Core9
			      <0x0 0x39300000 0x0 0x40000>, // GICR Core10
			      <0x0 0x39340000 0x0 0x40000>, // GICR Core11
			      <0x0 0x39380000 0x0 0x40000>, // GICR Core12
			      <0x0 0x393C0000 0x0 0x40000>, // GICR Core13
			      <0x0 0x39400000 0x0 0x40000>, // GICR Core14
			      <0x0 0x39440000 0x0 0x40000>, // GICR Core15
			      <0x0 0x39480000 0x0 0x40000>, // GICR Core16
			      <0x0 0x394C0000 0x0 0x40000>, // GICR Core17
			      <0x0 0x39500000 0x0 0x40000>, // GICR Core18
			      <0x0 0x39540000 0x0 0x40000>, // GICR Core19
			      <0x0 0x39580000 0x0 0x40000>, // GICR Core20
			      <0x0 0x395C0000 0x0 0x40000>, // GICR Core21
			      <0x0 0x39600000 0x0 0x40000>, // GICR Core22
			      <0x0 0x39640000 0x0 0x40000>, // GICR Core23
			      <0x0 0x39680000 0x0 0x40000>, // GICR Core24
			      <0x0 0x396C0000 0x0 0x40000>, // GICR Core25
			      <0x0 0x39700000 0x0 0x40000>, // GICR Core26
			      <0x0 0x39740000 0x0 0x40000>, // GICR Core27
			      <0x0 0x39780000 0x0 0x40000>, // GICR Core28
			      <0x0 0x397C0000 0x0 0x40000>, // GICR Core29
			      <0x0 0x39800000 0x0 0x40000>, // GICR Core30
			      <0x0 0x39840000 0x0 0x40000>; // GICR Core31
#endif
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
		};

		pfc: pinctrl@c0400000 {
			compatible = "renesas,pfc-r8a78000";
			reg = <0 0xc1080000 0 0x104>, <0 0xc1080800 0 0x104>,
			      <0 0xc1081000 0 0x104>, <0 0xc0800000 0 0x104>,
			      <0 0xc0800800 0 0x104>, <0 0xc0400000 0 0x104>,
			      <0 0xc0400800 0 0x104>, <0 0xc0401000 0 0x104>,
			      <0 0xc0401800 0 0x104>, <0 0xc9b00000 0 0x104>,
			      <0 0xc9b00800 0 0x104>;
		};

		i2c0: i2c@c11d0000 {
			compatible = "renesas,i2c-r8a78000",
				     "renesas,rcar-gen5-i2c";
			reg = <0 0xc11d0000 0 0x40>;
			interrupts = <GIC_SPI 4807 IRQ_TYPE_LEVEL_HIGH>;
			i2c-scl-internal-delay-ns = <110>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c1: i2c@c06c0000 {
			compatible = "renesas,i2c-r8a78000",
				     "renesas,rcar-gen5-i2c";
			reg = <0 0xc06c0000 0 0x40>;
			interrupts = <GIC_SPI 956 IRQ_TYPE_LEVEL_HIGH>;
			i2c-scl-internal-delay-ns = <110>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c2: i2c@c06c8000 {
			compatible = "renesas,i2c-r8a78000",
				     "renesas,rcar-gen5-i2c";
			reg = <0 0xc06c8000 0 0x40>;
			interrupts = <GIC_SPI 957 IRQ_TYPE_LEVEL_HIGH>;
			i2c-scl-internal-delay-ns = <110>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c3: i2c@c06d0000 {
			compatible = "renesas,i2c-r8a78000",
				     "renesas,rcar-gen5-i2c";
			reg = <0 0xc06d0000 0 0x40>;
