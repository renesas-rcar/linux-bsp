		dma-coherent;
	};

	virtio_mmio@16a000a00 {
		compatible = "virtio,mmio";
		reg = <0x1 0x6a000a00 0x0 0x200>;
		interrupts = <GIC_SPI 234 IRQ_TYPE_EDGE_RISING>;
		dma-coherent;
	};

	virtio_mmio@16a000c00 {
		compatible = "virtio,mmio";
		reg = <0x1 0x6a000c00 0x0 0x200>;
