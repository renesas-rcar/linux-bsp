		csi40: csi2@c4400000 {
			compatible = "renesas,r8a78000-csi2", "generic-uio";
			reg = <0 0xc4400000 0 0x4000>;
			interrupts = <GIC_SPI 498 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&dummy_clk>;
			//power-domains = <&sysc 64>;
			//resets = <&cpg 331>;
			status = "disabled";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					csi40_in: endpoint {
						bus-type = <0>; //DPHY
						clock-lanes = <0>;
						data-lanes = <1 2 3 4>;
						remote-endpoint = <&csi2cam_out0>;
					};
				};

				port@1 {
					reg = <1>;
					csi40isp0: endpoint {
						remote-endpoint = <&isp0csi40>;
					};
				};
			};
		};

