			reset-names = "vsp", "fcp";
			status = "disabled";
		};

		vspb1: vspm@c50c8000 {
			compatible = "renesas,vspm";
			reg = <0 0xc50c8000 0 0x8000>, <0 0xc5039000 0 0x200>;
			interrupts = <GIC_SPI 619 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&scmi_clk X5H_CLOCK_ID_VSPB1>,
					<&scmi_clk X5H_CLOCK_ID_FCPVB1>;
			clock-names = "vsp", "fcp";
			renesas,#ch = <5>;
			renesas,#rpf = <31>;
			renesas,#rpf_clut = <6>;
			renesas,#wpf_rot = <0>;
			renesas,has-bru;
			renesas,#read_outstanding = <0>;
			renesas,#start_reservation = <2>;
			renesas,#burst_access = <0>;
			power-domains = <&scmi_devpd X5H_POWER_DOMAIN_ID_VIO4>;
			resets = <&scmi_reset X5H_RESET_DOMAIN_ID_VSPB1>,
				 <&scmi_reset X5H_RESET_DOMAIN_ID_FCPVB1>;
			reset-names = "vsp", "fcp";
			status = "disabled";
		};

		vspb2: vspm@c50d0000 {
			compatible = "renesas,vspm";
			reg = <0 0xc50d0000 0 0x8000>, <0 0xc503a000 0 0x200>;
			interrupts = <GIC_SPI 620 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&scmi_clk X5H_CLOCK_ID_VSPB2>,
					<&scmi_clk X5H_CLOCK_ID_FCPVB2>;
			clock-names = "vsp", "fcp";
			renesas,#ch = <6>;
			renesas,#rpf = <31>;
			renesas,#rpf_clut = <6>;
			renesas,#wpf_rot = <0>;
			renesas,has-bru;
			renesas,#read_outstanding = <0>;
			renesas,#start_reservation = <2>;
			renesas,#burst_access = <0>;
			power-domains = <&scmi_devpd X5H_POWER_DOMAIN_ID_VIO4>;
			resets = <&scmi_reset X5H_RESET_DOMAIN_ID_VSPB2>,
				 <&scmi_reset X5H_RESET_DOMAIN_ID_FCPVB2>;
			reset-names = "vsp", "fcp";
			status = "disabled";
		};

		vspb3: vspm@c50d8000 {
			compatible = "renesas,vspm";
			reg = <0 0xc50d8000 0 0x8000>, <0 0xc503b000 0 0x200>;
			interrupts = <GIC_SPI 621 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&scmi_clk X5H_CLOCK_ID_VSPB3>,
					<&scmi_clk X5H_CLOCK_ID_FCPVB3>;
			clock-names = "vsp", "fcp";
			renesas,#ch = <7>;
			renesas,#rpf = <31>;
			renesas,#rpf_clut = <6>;
			renesas,#wpf_rot = <0>;
			renesas,has-bru;
			renesas,#read_outstanding = <0>;
			renesas,#start_reservation = <2>;
			renesas,#burst_access = <0>;
			power-domains = <&scmi_devpd X5H_POWER_DOMAIN_ID_VIO4>;
			resets = <&scmi_reset X5H_RESET_DOMAIN_ID_VSPB3>,
				 <&scmi_reset X5H_RESET_DOMAIN_ID_FCPVB3>;
			reset-names = "vsp", "fcp";
			status = "disabled";
		};

		vspb4: vspm@c50e0000 {
			compatible = "renesas,vspm";
			reg = <0 0xc50e0000 0 0x8000>, <0 0xc503c000 0 0x200>;
			interrupts = <GIC_SPI 622 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&scmi_clk X5H_CLOCK_ID_VSPB4>,
					<&scmi_clk X5H_CLOCK_ID_FCPVB4>;
			clock-names = "vsp", "fcp";
			renesas,#ch = <8>;
			renesas,#rpf = <31>;
			renesas,#rpf_clut = <6>;
			renesas,#wpf_rot = <0>;
			renesas,has-bru;
			renesas,#read_outstanding = <0>;
			renesas,#start_reservation = <2>;
			renesas,#burst_access = <0>;
			power-domains = <&scmi_devpd X5H_POWER_DOMAIN_ID_VIO4>;
			resets = <&scmi_reset X5H_RESET_DOMAIN_ID_VSPB4>,
				 <&scmi_reset X5H_RESET_DOMAIN_ID_FCPVB4>;
			reset-names = "vsp", "fcp";
			status = "disabled";
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts-extended = <&gic GIC_PPI 13 IRQ_TYPE_LEVEL_LOW>,
				      <&gic GIC_PPI 14 IRQ_TYPE_LEVEL_LOW>,
				      <&gic GIC_PPI 11 IRQ_TYPE_LEVEL_LOW>,
				      <&gic GIC_PPI 10 IRQ_TYPE_LEVEL_LOW>,
				      <&gic GIC_PPI 12 IRQ_TYPE_LEVEL_LOW>;
		interrupt-names = "sec-phys", "phys", "virt", "hyp-phys",
				  "hyp-virt";
	};

	ufs0_clk: ufs0-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		/* This value must be overridden by the board */
		clock-frequency = <0>;
	};

	ufs1_clk: ufs1-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		/* This value must be overridden by the board */
		clock-frequency = <0>;
	};
};
