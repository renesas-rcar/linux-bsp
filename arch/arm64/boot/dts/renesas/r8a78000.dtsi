		a720_0: cpu@0 {
			compatible = "arm,armv9", "arm,cortex-a720";
			reg = <0x0 0x0>;
			device_type = "cpu";
			next-level-cache = <&L1_CA720_0>;
			enable-method = "psci";

			L1_CA720_0: l1-cache-controller-0 {
