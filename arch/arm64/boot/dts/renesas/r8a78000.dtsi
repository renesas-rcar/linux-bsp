				};
				ssiu23: ssiu-19 {
					dmas = <&audio_dmac0 0x57>, <&audio_dmac1 0x56>;
					dma-names = "rx", "tx";
				};
				ssiu24: ssiu-20 {
					dmas = <&audio_dmac0 0x55>, <&audio_dmac1 0x54>;
					dma-names = "rx", "tx";
				};
				ssiu25: ssiu-21 {
					dmas = <&audio_dmac0 0x53>, <&audio_dmac1 0x52>;
