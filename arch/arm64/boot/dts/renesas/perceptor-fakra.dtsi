/*
 * Device Tree Source (overlay) for the Perceptor X5H FAKRA connectors
 *
 * Copyright (C) 2026 Renesas Electronics Corp.
 *
 * This overlay allows you to define cameras connected to the FAKRA
 * connectors on the PERCEPTOR (or compatible) board.
 *
 * Select each camera model by setting PERCEPTOR_CAMERA<n> to AR0820, IMX728,
 * or IMX623. Comment out a define to disconnect that camera from the DTB.
 *
 * "onnn,ar0820", "sony,imx728", and "sony,imx623" have a devicetree binding
 * under Documentation/devicetree/bindings/media/i2c/ for schema validation,
 * but their v4l2 subdev driver is maintained out-of-tree (the "gmsl_serdes"
 * project) and is not part of this kernel tree.
 */

#include <dt-bindings/gpio/gpio.h>

/* Model selectors also choose the remote sensor address. */
#define PERCEPTOR_SENSOR_COMPATIBLE_AR0820	"onnn,ar0820"
#define PERCEPTOR_SENSOR_COMPATIBLE_IMX728	"sony,imx728"
#define PERCEPTOR_SENSOR_COMPATIBLE_IMX623	"sony,imx623"

#define PERCEPTOR_SENSOR_I2C_ADDR_AR0820		0x10
#define PERCEPTOR_SENSOR_I2C_ADDR_IMX728		0x1a
#define PERCEPTOR_SENSOR_I2C_ADDR_IMX623		0x1a

#define PERCEPTOR_SENSOR_COMPATIBLE_EXPAND(model) \
	PERCEPTOR_SENSOR_COMPATIBLE_##model
#define PERCEPTOR_SENSOR_COMPATIBLE(model) \
	PERCEPTOR_SENSOR_COMPATIBLE_EXPAND(model)
#define PERCEPTOR_SENSOR_I2C_ADDR_EXPAND(model) \
	PERCEPTOR_SENSOR_I2C_ADDR_##model
#define PERCEPTOR_SENSOR_I2C_ADDR(model) \
	PERCEPTOR_SENSOR_I2C_ADDR_EXPAND(model)

#define PERCEPTOR_CAMERA0  IMX728
#define PERCEPTOR_CAMERA1  IMX728
#define PERCEPTOR_CAMERA2  IMX728
#define PERCEPTOR_CAMERA3  IMX728
#define PERCEPTOR_CAMERA4  IMX728
#define PERCEPTOR_CAMERA5  IMX728
#define PERCEPTOR_CAMERA6  IMX728
#define PERCEPTOR_CAMERA7  IMX728
#define PERCEPTOR_CAMERA8  IMX728
#define PERCEPTOR_CAMERA9  IMX728
#define PERCEPTOR_CAMERA10 IMX728
#define PERCEPTOR_CAMERA11 IMX728
#define PERCEPTOR_CAMERA12 IMX728
#define PERCEPTOR_CAMERA13 IMX728
#define PERCEPTOR_CAMERA14 IMX728
#define PERCEPTOR_CAMERA15 IMX728

/* Define the endpoint links */
#ifdef PERCEPTOR_CAMERA0
&max96726_in0 {
	remote-endpoint = <&fakra_con0>;
};
#endif

#ifdef PERCEPTOR_CAMERA1
&max96726_in1 {
	remote-endpoint = <&fakra_con1>;
};
#endif

#ifdef PERCEPTOR_CAMERA2
&max96726_in2 {
	remote-endpoint = <&fakra_con2>;
};
#endif

#ifdef PERCEPTOR_CAMERA3
&max96726_in3 {
	remote-endpoint = <&fakra_con3>;
};
#endif

#ifdef PERCEPTOR_CAMERA4
&max96726_in4 {
	remote-endpoint = <&fakra_con4>;
};
#endif

#ifdef PERCEPTOR_CAMERA5
&max96726_in5 {
	remote-endpoint = <&fakra_con5>;
};
#endif

#ifdef PERCEPTOR_CAMERA6
&max96726_in6 {
	remote-endpoint = <&fakra_con6>;
};
#endif

#ifdef PERCEPTOR_CAMERA7
&max96726_in7 {
	remote-endpoint = <&fakra_con7>;
};
#endif

#ifdef PERCEPTOR_CAMERA8
&max96726_in8 {
	remote-endpoint = <&fakra_con8>;
};
#endif

#ifdef PERCEPTOR_CAMERA9
&max96726_in9 {
	remote-endpoint = <&fakra_con9>;
};
#endif

#ifdef PERCEPTOR_CAMERA10
&max96726_in10 {
	remote-endpoint = <&fakra_con10>;
};
#endif

#ifdef PERCEPTOR_CAMERA11
&max96726_in11 {
	remote-endpoint = <&fakra_con11>;
};
#endif

#ifdef PERCEPTOR_CAMERA12
&max96726_in12 {
	remote-endpoint = <&fakra_con12>;
};
#endif

#ifdef PERCEPTOR_CAMERA13
&max96726_in13 {
	remote-endpoint = <&fakra_con13>;
};
#endif

#ifdef PERCEPTOR_CAMERA14
&max96726_in14 {
	remote-endpoint = <&fakra_con14>;
};
#endif

#ifdef PERCEPTOR_CAMERA15
&max96726_in15 {
	remote-endpoint = <&fakra_con15>;
};
#endif

/*
 * Camera reg values are Linux-side aliases. The remote sensor's native
 * 7-bit I2C address is configured separately on each camera node.
 */
&gmsl0 {

#if defined(PERCEPTOR_CAMERA0) || defined(PERCEPTOR_CAMERA1) || \
	defined(PERCEPTOR_CAMERA2) || defined(PERCEPTOR_CAMERA3)
	status = "okay";

#endif

	i2c-mux {
#ifdef PERCEPTOR_CAMERA0
		i2c@0 {
			status = "okay";

			camera@49 {
				compatible =
					PERCEPTOR_SENSOR_COMPATIBLE(PERCEPTOR_CAMERA0);
				reg = <0x49>;
				maxim,sensor-remote-i2c-addr =
					<PERCEPTOR_SENSOR_I2C_ADDR(PERCEPTOR_CAMERA0)>;

				port {
					fakra_con0: endpoint {
						remote-endpoint = <&max96726_in0>;
					};
				};
			};
		};
#endif

#ifdef PERCEPTOR_CAMERA1
		i2c@1 {
			status = "okay";

			camera@51 {
				compatible =
					PERCEPTOR_SENSOR_COMPATIBLE(PERCEPTOR_CAMERA1);
				reg = <0x51>;
				maxim,sensor-remote-i2c-addr =
					<PERCEPTOR_SENSOR_I2C_ADDR(PERCEPTOR_CAMERA1)>;

				port {
					fakra_con1: endpoint {
						remote-endpoint = <&max96726_in1>;
					};
				};
			};
		};
#endif

#ifdef PERCEPTOR_CAMERA2
		i2c@2 {
			status = "okay";

			camera@59 {
				compatible =
					PERCEPTOR_SENSOR_COMPATIBLE(PERCEPTOR_CAMERA2);
				reg = <0x59>;
				maxim,sensor-remote-i2c-addr =
					<PERCEPTOR_SENSOR_I2C_ADDR(PERCEPTOR_CAMERA2)>;

				port {
					fakra_con2: endpoint {
						remote-endpoint = <&max96726_in2>;
					};
				};
			};
		};
#endif

#ifdef PERCEPTOR_CAMERA3
		i2c@3 {
			status = "okay";

			camera@61 {
				compatible =
					PERCEPTOR_SENSOR_COMPATIBLE(PERCEPTOR_CAMERA3);
				reg = <0x61>;
				maxim,sensor-remote-i2c-addr =
					<PERCEPTOR_SENSOR_I2C_ADDR(PERCEPTOR_CAMERA3)>;

				port {
					fakra_con3: endpoint {
						remote-endpoint = <&max96726_in3>;
					};
				};
			};
		};
#endif
	};
};

