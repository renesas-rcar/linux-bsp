		/* Cluster2 - CPU0 debug */
		a2_dbg0: debug@2a890000 {
			compatible = "arm,coresight-cpu-debug", "arm,primecell";
			reg = <0x0 0x2a890000 0x0 0x1000>;

			clocks = <&apb_pclk>;
			clock-names = "apb_pclk";

			status = "disabled";

