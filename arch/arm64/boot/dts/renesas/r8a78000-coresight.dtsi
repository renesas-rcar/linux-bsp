/*
 * Device Tree Source fragment for Coresight support on the R-Car X5H
 * (R8A78000) SoC
 *
 * Copyright (C) 2025 Renesas Electronics Corp.
 */

#include <dt-bindings/arm/coresight-cti-dt.h>
#include "r8a78000.dtsi"

/ {
	compatible = "renesas,r8a78000", "renesas,r8a78000-coresight";

	/* APB clock */
	apb_pclk: apb-pclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <0>;
		clock-output-names = "apb_pclk";
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		etr1_trace_mem_reserved: etr1_t@1e00000000 {
			no-map;
			reg = <0x1e 0x0 0x0 0x2000000>;
		};

		etr1_mdata_mem_reserved: etr1_m@1e02000000 {
			no-map;
			reg = <0x1e 0x2000000 0x0 0x2000000>;
		};
	};

	soc: soc {
		csd_rep2: replicator {
			compatible = "arm,coresight-static-replicator";
			status = "disabled";

			in-ports {
				port {
					replicator2_in_port: endpoint {
						remote-endpoint = <&funnel2_out_port0>;
					};
				};
			};

			out-ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@1 {
					reg = <1>;
					replicator2_out_port1: endpoint {
						remote-endpoint = <&funnel1_in_port0>;
					};
				};
			};
		};

		csd_fun1: funnel@28070000 {
			compatible = "arm,coresight-dynamic-funnel", "arm,primecell";
			reg = <0x0 0x28070000 0x0 0x1000>;

			clocks = <&apb_pclk>;
			clock-names = "apb_pclk";

			status = "disabled";

			out-ports {
				port {
					funnel1_out_port: endpoint {
						remote-endpoint = <&etf1_in_port>;
					};
				};
			};

			in-ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					funnel1_in_port0: endpoint {
						remote-endpoint = <&replicator2_out_port1>;
					};
				};
			};
		};

		csd_fun2: funnel@28080000 {
			compatible = "arm,coresight-dynamic-funnel", "arm,primecell";
			reg = <0x0 0x28080000 0x0 0x1000>;

			clocks = <&apb_pclk>;
			clock-names = "apb_pclk";

			status = "disabled";

			out-ports {
				port {
					funnel2_out_port0: endpoint {
						remote-endpoint = <&replicator2_in_port>;
					};
				};
			};

			in-ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@3 {
					reg = <3>;
					funnel2_in_port3: endpoint {
						remote-endpoint = <&funnel5_out_port>;
					};
				};

				port@5 {
					reg = <5>;
					funnel2_in_port5: endpoint {
						remote-endpoint = <&stm0_out_port>;
					};
				};
			};
		};

		csd_fun5: funnel@280b0000 {
			compatible = "arm,coresight-dynamic-funnel", "arm,primecell";
			reg = <0x0 0x280b0000 0x0 0x1000>;

			clocks = <&apb_pclk>;
			clock-names = "apb_pclk";

			status = "disabled";

			out-ports {
				port {
					funnel5_out_port: endpoint {
						remote-endpoint = <&funnel2_in_port3>;
					};
				};
			};

			in-ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					funnel5_in_port0: endpoint {
						remote-endpoint = <&a0_funnel_out>;
					};
				};

				port@1 {
					reg = <1>;
					funnel5_in_port1: endpoint {
						remote-endpoint = <&a1_funnel_out>;
					};
				};

				port@2 {
					reg = <2>;
					funnel5_in_port2: endpoint {
						remote-endpoint = <&a2_funnel_out>;
					};
				};

				port@3 {
					reg = <3>;
					funnel5_in_port3: endpoint {
						remote-endpoint = <&a3_funnel_out>;
					};
				};

				port@4 {
					reg = <4>;
					funnel5_in_port4: endpoint {
						remote-endpoint = <&a4_funnel_out>;
					};
				};

				port@5 {
					reg = <5>;
					funnel5_in_port5: endpoint {
						remote-endpoint = <&a5_funnel_out>;
					};
				};

				port@6 {
					reg = <6>;
					funnel5_in_port6: endpoint {
						remote-endpoint = <&a6_funnel_out>;
					};
				};

				port@7 {
					reg = <7>;
					funnel5_in_port7: endpoint {
						remote-endpoint = <&a7_funnel_out>;
					};
				};
			};
		};

		a0_fun: funnel0 {
			compatible = "arm,coresight-static-funnel";

			out-ports {
				port {
					a0_funnel_out: endpoint {
						remote-endpoint = <&funnel5_in_port0>;
					};
				};
			};

			in-ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					a0_funnel_in0: endpoint {
						remote-endpoint = <&ete0_out_port>;
					};
				};

				port@1 {
					reg = <1>;
					a0_funnel_in1: endpoint {
						remote-endpoint = <&ete1_out_port>;
					};
				};

				port@2 {
					reg = <2>;
					a0_funnel_in2: endpoint {
						remote-endpoint = <&ete2_out_port>;
					};
				};

				port@3 {
					reg = <3>;
					a0_funnel_in3: endpoint {
						remote-endpoint = <&ete3_out_port>;
					};
				};
			};
		};

		a1_fun: funnel1 {
			compatible = "arm,coresight-static-funnel";

			out-ports {
				port {
					a1_funnel_out: endpoint {
						remote-endpoint = <&funnel5_in_port1>;
					};
				};
			};

			in-ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					a1_funnel_in0: endpoint {
						remote-endpoint = <&ete4_out_port>;
					};
				};

				port@1 {
					reg = <1>;
					a1_funnel_in1: endpoint {
						remote-endpoint = <&ete5_out_port>;
					};
				};

				port@2 {
					reg = <2>;
					a1_funnel_in2: endpoint {
						remote-endpoint = <&ete6_out_port>;
					};
				};

				port@3 {
					reg = <3>;
					a1_funnel_in3: endpoint {
						remote-endpoint = <&ete7_out_port>;
					};
				};
			};
		};

		a2_fun: funnel2 {
			compatible = "arm,coresight-static-funnel";

			out-ports {
				port {
					a2_funnel_out: endpoint {
						remote-endpoint = <&funnel5_in_port2>;
					};
				};
			};

			in-ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					a2_funnel_in0: endpoint {
						remote-endpoint = <&ete8_out_port>;
					};
				};

				port@1 {
					reg = <1>;
					a2_funnel_in1: endpoint {
						remote-endpoint = <&ete9_out_port>;
					};
				};

				port@2 {
					reg = <2>;
					a2_funnel_in2: endpoint {
						remote-endpoint = <&ete10_out_port>;
					};
				};

				port@3 {
					reg = <3>;
					a2_funnel_in3: endpoint {
						remote-endpoint = <&ete11_out_port>;
					};
				};
			};
		};

		a3_fun: funnel3 {
			compatible = "arm,coresight-static-funnel";

			out-ports {
				port {
					a3_funnel_out: endpoint {
						remote-endpoint = <&funnel5_in_port3>;
					};
				};
			};

			in-ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					a3_funnel_in0: endpoint {
						remote-endpoint = <&ete12_out_port>;
					};
				};

				port@1 {
					reg = <1>;
					a3_funnel_in1: endpoint {
						remote-endpoint = <&ete13_out_port>;
					};
				};

				port@2 {
					reg = <2>;
					a3_funnel_in2: endpoint {
						remote-endpoint = <&ete14_out_port>;
					};
				};

				port@3 {
					reg = <3>;
					a3_funnel_in3: endpoint {
						remote-endpoint = <&ete15_out_port>;
					};
				};
			};
		};

		a4_fun: funnel4 {
			compatible = "arm,coresight-static-funnel";

			out-ports {
				port {
					a4_funnel_out: endpoint {
						remote-endpoint = <&funnel5_in_port4>;
					};
				};
			};

			in-ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					a4_funnel_in0: endpoint {
						remote-endpoint = <&ete16_out_port>;
					};
				};

				port@1 {
					reg = <1>;
					a4_funnel_in1: endpoint {
						remote-endpoint = <&ete17_out_port>;
					};
				};

				port@2 {
					reg = <2>;
					a4_funnel_in2: endpoint {
						remote-endpoint = <&ete18_out_port>;
					};
				};

				port@3 {
					reg = <3>;
					a4_funnel_in3: endpoint {
						remote-endpoint = <&ete19_out_port>;
					};
				};
			};
		};

		a5_fun: funnel5 {
			compatible = "arm,coresight-static-funnel";

			out-ports {
				port {
					a5_funnel_out: endpoint {
						remote-endpoint = <&funnel5_in_port5>;
					};
				};
			};

			in-ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					a5_funnel_in0: endpoint {
						remote-endpoint = <&ete20_out_port>;
					};
				};

				port@1 {
					reg = <1>;
					a5_funnel_in1: endpoint {
						remote-endpoint = <&ete21_out_port>;
					};
				};

				port@2 {
					reg = <2>;
					a5_funnel_in2: endpoint {
						remote-endpoint = <&ete22_out_port>;
					};
				};

				port@3 {
					reg = <3>;
					a5_funnel_in3: endpoint {
						remote-endpoint = <&ete23_out_port>;
					};
				};
			};
		};

		a6_fun: funnel6 {
			compatible = "arm,coresight-static-funnel";

			out-ports {
				port {
					a6_funnel_out: endpoint {
						remote-endpoint = <&funnel5_in_port6>;
					};
				};
			};

			in-ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					a6_funnel_in0: endpoint {
						remote-endpoint = <&ete24_out_port>;
					};
				};

				port@1 {
					reg = <1>;
					a6_funnel_in1: endpoint {
						remote-endpoint = <&ete25_out_port>;
					};
				};

				port@2 {
					reg = <2>;
					a6_funnel_in2: endpoint {
						remote-endpoint = <&ete26_out_port>;
					};
				};

				port@3 {
					reg = <3>;
					a6_funnel_in3: endpoint {
						remote-endpoint = <&ete27_out_port>;
					};
				};
			};
		};

		a7_fun: funnel7 {
			compatible = "arm,coresight-static-funnel";

			out-ports {
				port {
					a7_funnel_out: endpoint {
						remote-endpoint = <&funnel5_in_port7>;
					};
				};
			};

			in-ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					a7_funnel_in0: endpoint {
						remote-endpoint = <&ete28_out_port>;
					};
				};

				port@1 {
					reg = <1>;
					a7_funnel_in1: endpoint {
						remote-endpoint = <&ete29_out_port>;
					};
				};

				port@2 {
					reg = <2>;
					a7_funnel_in2: endpoint {
						remote-endpoint = <&ete30_out_port>;
					};
				};

				port@3 {
					reg = <3>;
					a7_funnel_in3: endpoint {
						remote-endpoint = <&ete31_out_port>;
					};
				};
			};
		};

		csd_stm0: stm@28010000 {
			compatible = "arm,coresight-stm", "arm,primecell";
			reg = <0x0 0x28010000 0x0 0x1000>,
			      <0x0 0x24000000 0x0 0x100000>;
			reg-names = "stm-base", "stm-stimulus-base";

			clocks = <&apb_pclk>;
			clock-names = "apb_pclk";

			status = "disabled";

			out-ports {
				port {
					stm0_out_port: endpoint {
						remote-endpoint = <&funnel2_in_port5>;
					};
				};
			};
		};

		csd_tpi1: tpiu@280e0000 {
			compatible = "arm,coresight-tpiu", "arm,primecell";
			reg = <0x0 0x280e0000 0x0 0x1000>;

			clocks = <&apb_pclk>;
			clock-names = "apb_pclk";

			status = "disabled";

			in-ports {
				port {
					tpi1_in_port: endpoint {
						remote-endpoint = <&rep1_out_port1>;
					};
				};
			};
		};

		csd_etf1: etf@28100000 {
			compatible = "arm,coresight-tmc", "arm,primecell";
			reg = <0x0 0x28100000 0x0 0x1000>;

			clocks = <&apb_pclk>;
			clock-names = "apb_pclk";

			status = "disabled";

			in-ports {
				port {
					etf1_in_port: endpoint {
						remote-endpoint = <&funnel1_out_port>;
					};
				};
			};

			out-ports {
				port {
					etf1_out_port: endpoint {
						remote-endpoint = <&rep1_in_port>;
					};
				};
			};
		};

		csd_rep1: replicator@281a0000 {
			compatible = "arm,coresight-dynamic-replicator", "arm,primecell";
			reg = <0x0 0x281a0000 0x0 0x1000>;

			clocks = <&apb_pclk>;
			clock-names = "apb_pclk";

			status = "disabled";

			in-ports {
				port@0 {
					rep1_in_port: endpoint {
						remote-endpoint = <&etf1_out_port>;
					};
				};
			};

			out-ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					rep1_out_port0: endpoint {
						remote-endpoint = <&etr1_in_port>;
					};
				};

				port@1 {
					reg = <1>;
					rep1_out_port1: endpoint {
						remote-endpoint = <&tpi1_in_port>;
					};
				};
			};
		};

		csd_etr1: etr1@28120000 {
			compatible = "arm,coresight-tmc", "arm,primecell";
			reg = <0x0 0x28120000 0x0 0x1000>;

			memory-region = <&etr1_trace_mem_reserved>,
					<&etr1_mdata_mem_reserved>;
			memory-region-names = "tracedata", "metadata";

			clocks = <&apb_pclk>;
			clock-names = "apb_pclk";

			status = "disabled";

			in-ports {
				port {
					etr1_in_port: endpoint {
						remote-endpoint = <&rep1_out_port0>;
					};
				};
			};
		};

		csd_cti3: cti3@28160000 {
			compatible = "arm,coresight-cti", "arm,primecell";
			reg = <0x0 0x28160000 0x0 0x1000>;

			clocks = <&apb_pclk>;
			clock-names = "apb_pclk";

			arm,cti-ctm-id = <4>;
			#address-cells = <1>;
			#size-cells = <0>;

			status = "disabled";

			trig-conns@0 {
				arm,trig-in-sigs=<0 1 2 3>;
				arm,trig-in-types=<STM_TOUT_SPTE STM_TOUT_SW
						   STM_TOUT_HETE STM_ASYNCOUT>;
				arm,trig-out-sigs=<0 1>;
				arm,trig-out-types=<STM_HWEVENT STM_HWEVENT>;
				arm,cs-dev-assoc = <&csd_stm0>;
			};
		};

		/* Cluster0 - CPU0 Debug */
		a0_dbg0: debug@2a090000 {
			compatible = "arm,coresight-cpu-debug", "arm,primecell";
			reg = <0x0 0x2a090000 0x0 0x1000>;

			clocks = <&apb_pclk>;
			clock-names = "apb_pclk";

			status = "disabled";

			cpu = <&a720_0>;
		};

		/* Cluster0 -  CPU1 Debug */
		a0_dbg1: debug@2a110000 {
			compatible = "arm,coresight-cpu-debug", "arm,primecell";
			reg = <0x0 0x2a110000 0x0 0x1000>;

			clocks = <&apb_pclk>;
			clock-names = "apb_pclk";

			status = "disabled";

			cpu = <&a720_1>;
		};

		/* Cluster0 - CPU2 Debug */
		a0_dbg2: debug@2a190000 {
