			reg = <0x0 0x2a190000 0x0 0x1000>;

			clocks = <&apb_pclk>;
			clock-names = "apb_pclk";

			status = "disabled";

			cpu = <&a720_2>;
		};

		/* Cluster0 - CPU3 Debug */
		a0_dbg3: debug@2a210000 {
			compatible = "arm,coresight-cpu-debug", "arm,primecell";
			reg = <0x0 0x2a210000 0x0 0x1000>;

			clocks = <&apb_pclk>;
			clock-names = "apb_pclk";

			status = "disabled";

			cpu = <&a720_3>;
		};

		/* Cluster1 - CPU0 debug */
		a1_dbg0: debug@2a490000 {
			compatible = "arm,coresight-cpu-debug", "arm,primecell";
			reg = <0x0 0x2a490000 0x0 0x1000>;

			clocks = <&apb_pclk>;
