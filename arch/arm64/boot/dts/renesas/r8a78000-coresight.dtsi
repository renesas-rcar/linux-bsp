			clocks = <&apb_pclk>;
			clock-names = "apb_pclk";

			status = "disabled";

			cpu = <&a720_11>;
		};

		/* Cluster3 - CPU0 debug */
		a3_dbg0: debug@2ac90000 {
			compatible = "arm,coresight-cpu-debug", "arm,primecell";
			reg = <0x0 0x2ac90000 0x0 0x1000>;

			clocks = <&apb_pclk>;
			clock-names = "apb_pclk";

			status = "disabled";

			cpu = <&a720_12>;
		};

		/* Cluster3 - CPU1 debug */
		a3_dbg1: debug@2ad10000 {
			compatible = "arm,coresight-cpu-debug", "arm,primecell";
			reg = <0x0 0x2ad10000 0x0 0x1000>;

			clocks = <&apb_pclk>;
			clock-names = "apb_pclk";

			status = "disabled";

			cpu = <&a720_13>;
		};

		/* Cluster3 - CPU2 debug */
		a3_dbg2: debug@2ad90000 {
			compatible = "arm,coresight-cpu-debug", "arm,primecell";
