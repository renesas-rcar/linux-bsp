			clocks = <&apb_pclk>;
			clock-names = "apb_pclk";

			status = "disabled";

			cpu = <&a720_5>;
		};

		/* Cluster1 - CPU2 debug */
		a1_dbg2: debug@2a590000 {
			compatible = "arm,coresight-cpu-debug", "arm,primecell";
			reg = <0x0 0x2a590000 0x0 0x1000>;

			clocks = <&apb_pclk>;
