		};

		/* Cluster2 - CPU1 debug */
		a2_dbg1: debug@2a910000 {
			compatible = "arm,coresight-cpu-debug", "arm,primecell";
			reg = <0x0 0x2a910000 0x0 0x1000>;

			clocks = <&apb_pclk>;
			clock-names = "apb_pclk";

			status = "disabled";

