			reg = <0 0xc495e000 0 0x1000>;
			interrupts = <GIC_SPI 604 IRQ_TYPE_LEVEL_HIGH>;
			linux,uio-name = "vin_116";
		};

		vin_117: video@c495f000 {
			compatible = "generic-uio";
			reg = <0 0xc495f000 0 0x1000>;
			interrupts = <GIC_SPI 605 IRQ_TYPE_LEVEL_HIGH>;
			linux,uio-name = "vin_117";
		};
	};
};
