#include <dt-bindings/ipmmu/rcar-ipmmu.h>
#include "r8a78000.dtsi"

/ {
	compatible = "renesas,r8a78000", "renesas,r8a78000-uio";

	soc: soc {
		imrlx7_ims00: ims@c1800000{
			compatible = "generic-uio";
			reg = <0 0xc1800000 0 0x10000>;
			interrupts = <GIC_SPI 606 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&scmi_clk X5H_CLOCK_ID_IMN_IMS00>;
			power-domains = <&scmi_devpd X5H_POWER_DOMAIN_ID_IM0>;
			linux,uio-name = "ims_00";
		};

		imrlx7_ims01: ims@c1810000{
