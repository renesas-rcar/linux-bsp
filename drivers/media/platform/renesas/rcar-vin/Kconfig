config VIDEO_RCAR_VIN
	tristate "R-Car Video Input (VIN) Driver"
	depends on V4L_PLATFORM_DRIVERS
	depends on VIDEO_DEV && OF
	depends on ARCH_RENESAS || COMPILE_TEST
	select MEDIA_CONTROLLER
	select VIDEO_V4L2_SUBDEV_API
	select RESET_CONTROLLER
	select VIDEOBUF2_DMA_CONTIG
	select V4L2_FWNODE
	help
	  Support for Renesas R-Car Video Input (VIN) driver.
	  Supports R-Car Gen{2,3} and RZ/G{1,2} SoCs.

	  To compile this driver as a module, choose M here: the
	  module will be called rcar-vin.

config VIDEO_RCAR_VIN_DEBUG
	bool "R-Car VIN overflow debug messages"
	depends on VIDEO_RCAR_VIN
	help
	  Enable debug overflow messages on R-Car Video
	  Input driver.
	  If you set to enable, When an overflow occurred,
	  a debug overflow message is output.

config VIDEO_SNPS_CSI2_CAMERA
	bool "Synopsys CSI-2 Camera Driver"
	depends on VIDEO_RCAR_CSI2
	help
	  Dummy Driver for Synopsys CSI-2 Camera
	  model on VDK.

config VIDEO_RCAR_VIN_VDK
	bool "R-Car VIN Driver for VDK simulation"
	depends on VIDEO_RCAR_VIN
	help
	  Enable R-Car Video Input driver on VDK environment.

